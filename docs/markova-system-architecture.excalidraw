        {
          "id": "t9goo9pts",
          "type": "text",
          "x": 2323,
          "y": 3277.3,
          "width": 382.8,
          "height": 288.8,
          "angle": 0,
          "strokeColor": "#343a40",
          "backgroundColor": "transparent",
          "fillStyle": "solid",
          "strokeWidth": 1,
          "strokeStyle": "solid",
          "roughness": 1,
          "opacity": 100,
          "groupIds": [
            "g9cub4jcw"
          ],
          "frameId": null,
          "roundness": null,
          "seed": 1128093440,
          "version": 1,
          "versionNonce": 463485696,
          "isDeleted": false,
          "boundElements": null,
          "updated": 1,
          "link": null,
          "locked": false,
          "text": "STUDENTS\nPOST /            one record, daily or per subject\nPOST /bulk        a whole class in one call\nPOST /qr-scan     a QR code becomes attendance\nPOST /nfc-scan    a card tap becomes PRESENT or LATE,\n                  decided by isAfterDailyCutoff(now)\nPOST /register-nfc   bind a card id to a student\nGET  /class-students roster + who has a card\nGET  /            query and filter\nGET  /class       one section, one date\nGET  /student-summary  [4 roles] present/absent/late %\n   unique (studentId, date, type, subjectId)\n   PRESENT|ABSENT|LATE, and a reason category of\n   SICK|FAMILY|PERMISSION|UNEXCUSED\n\nTEACHERS   POST /teacher · POST /teacher/qr-scan\n           GET /teacher                     [ADMIN]\n\nWATCHING   GET /chronic          [ADMIN]\n           POST /chronic/notify  [ADMIN] + the Monday cron\n           GET /dashboard        [ADMIN] today at a glance",
          "fontSize": 11,
          "fontFamily": 3,
          "textAlign": "left",
          "verticalAlign": "top",
          "containerId": null,
          "originalText": "STUDENTS\nPOST /            one record, daily or per subject\nPOST /bulk        a whole class in one call\nPOST /qr-scan     a QR code becomes attendance\nPOST /nfc-scan    a card tap becomes PRESENT or LATE,\n                  decided by isAfterDailyCutoff(now)\nPOST /register-nfc   bind a card id to a student\nGET  /class-students roster + who has a card\nGET  /            query and filter\nGET  /class       one section, one date\nGET  /student-summary  [4 roles] present/absent/late %\n   unique (studentId, date, type, subjectId)\n   PRESENT|ABSENT|LATE, and a reason category of\n   SICK|FAMILY|PERMISSION|UNEXCUSED\n\nTEACHERS   POST /teacher · POST /teacher/qr-scan\n           GET /teacher                     [ADMIN]\n\nWATCHING   GET /chronic          [ADMIN]\n           POST /chronic/notify  [ADMIN] + the Monday cron\n           GET /dashboard        [ADMIN] today at a glance",
          "autoResize": true,
          "lineHeight": 1.25
        }
      ]
