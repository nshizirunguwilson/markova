        {
          "id": "t8oi7mz5s",
          "type": "text",
          "x": 823,
          "y": 3277.3,
          "width": 369.6,
          "height": 357.5,
          "angle": 0,
          "strokeColor": "#343a40",
          "backgroundColor": "transparent",
          "fillStyle": "solid",
          "strokeWidth": 1,
          "strokeStyle": "solid",
          "roughness": 1,
          "opacity": 100,
          "groupIds": [
            "g8kthhn9c"
          ],
          "frameId": null,
          "roundness": null,
          "seed": 1379526656,
          "version": 1,
          "versionNonce": 391641088,
          "isDeleted": false,
          "boundElements": null,
          "updated": 1,
          "link": null,
          "locked": false,
          "text": "ENTRY\nPOST /                 [ADMIN,TEACHER] one mark\nPOST /batch            [ADMIN,TEACHER] a whole class\nGET  /                 filter by class, subject, term\nGET  /completion       what is still missing\nGET  /:id · PUT /:id · DELETE /:id\n   a teacher may only touch their own marks. unique on\n   (studentId, subjectId, termId, assessmentTypeId)\n\nTERM RESULTS\nPOST /term-results/calculate      [ADMIN]\n   weights + the NESA scale → totals, average,\n   letterGrade, aggregate, aggregateMax, rank\nGET  /term-results/class          [ADMIN,TEACHER]\nGET  /term-results/student/:id    [+STUDENT,PARENT]\nPUT  /term-results/:id/comment    teacher + headmaster\nPOST /term-results/publish        [ADMIN] isPublished\n   nothing is visible to a student or parent before this\n\nYEAR RESULTS\nPOST /year-results/calculate      [ADMIN]\n   term1/2/3 averages → yearlyAverage, letterGrade,\n   rank, disciplineAverage, isPromoted\nGET  /year-results/class · /year-results/student/:id\n\nGET  /report-card/:studentId      the assembled card",
          "fontSize": 11,
          "fontFamily": 3,
          "textAlign": "left",
          "verticalAlign": "top",
          "containerId": null,
          "originalText": "ENTRY\nPOST /                 [ADMIN,TEACHER] one mark\nPOST /batch            [ADMIN,TEACHER] a whole class\nGET  /                 filter by class, subject, term\nGET  /completion       what is still missing\nGET  /:id · PUT /:id · DELETE /:id\n   a teacher may only touch their own marks. unique on\n   (studentId, subjectId, termId, assessmentTypeId)\n\nTERM RESULTS\nPOST /term-results/calculate      [ADMIN]\n   weights + the NESA scale → totals, average,\n   letterGrade, aggregate, aggregateMax, rank\nGET  /term-results/class          [ADMIN,TEACHER]\nGET  /term-results/student/:id    [+STUDENT,PARENT]\nPUT  /term-results/:id/comment    teacher + headmaster\nPOST /term-results/publish        [ADMIN] isPublished\n   nothing is visible to a student or parent before this\n\nYEAR RESULTS\nPOST /year-results/calculate      [ADMIN]\n   term1/2/3 averages → yearlyAverage, letterGrade,\n   rank, disciplineAverage, isPromoted\nGET  /year-results/class · /year-results/student/:id\n\nGET  /report-card/:studentId      the assembled card",
          "autoResize": true,
          "lineHeight": 1.25
        }
