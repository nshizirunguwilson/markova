          "seed": 1326883840,
          "version": 1,
          "versionNonce": 1788609536,
          "isDeleted": false,
          "boundElements": null,
          "updated": 1,
          "link": null,
          "locked": false,
          "text": "O_CORE        CAT 1  20 %   +   CAT 2  20 %   +   End of Term Exam  60 %\nO_ELECTIVE    CAT 1  20 %   +   CAT 2  20 %   +   End of Term Exam  60 %\nA_GENERAL     CAT 1  20 %   +   CAT 2  20 %   +   End of Term Exam  60 %\nA_SPECIFIC    CAT 1  15 %  +  CAT 2  15 %  +  Practical  30 %  +  Exam  40 %\n\nA_SPECIFIC is the trade specific RTB module. The keys are the seeded\nAssessmentType names and they are matched exactly, character for character.",
          "fontSize": 13,
          "fontFamily": 3,
          "textAlign": "left",
          "verticalAlign": "top",
          "containerId": null,
          "originalText": "O_CORE        CAT 1  20 %   +   CAT 2  20 %   +   End of Term Exam  60 %\nO_ELECTIVE    CAT 1  20 %   +   CAT 2  20 %   +   End of Term Exam  60 %\nA_GENERAL     CAT 1  20 %   +   CAT 2  20 %   +   End of Term Exam  60 %\nA_SPECIFIC    CAT 1  15 %  +  CAT 2  15 %  +  Practical  30 %  +  Exam  40 %\n\nA_SPECIFIC is the trade specific RTB module. The keys are the seeded\nAssessmentType names and they are matched exactly, character for character.",
          "autoResize": true,
          "lineHeight": 1.25
        }
      ]
    },
