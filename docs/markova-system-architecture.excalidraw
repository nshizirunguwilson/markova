        {
          "id": "tcja30nwg",
          "type": "text",
          "x": 2872,
          "y": 4910.8,
          "width": 592.8,
          "height": 113.8,
          "angle": 0,
          "strokeColor": "#343a40",
          "backgroundColor": "transparent",
          "fillStyle": "solid",
          "strokeWidth": 1,
          "strokeStyle": "solid",
          "roughness": 1,
