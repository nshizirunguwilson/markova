      "seed": 1459161600,
      "version": 1,
      "versionNonce": 622162432,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "New messages fan out to each participant's user:<id> room rather than to conv:<id>, because a\nconversation created after a socket connected has nobody in its conv room yet. User.lastSeenAt\nis stamped on disconnect, and anything undelivered flips to DELIVERED when the recipient returns.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "New messages fan out to each participant's user:<id> room rather than to conv:<id>, because a\nconversation created after a socket connected has nobody in its conv room yet. User.lastSeenAt\nis stamped on disconnect, and anything undelivered flips to DELIVERED when the recipient returns.",
      "autoResize": true,
      "lineHeight": 1.25
    },
