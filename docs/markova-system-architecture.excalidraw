          "version": 1,
          "versionNonce": 67215360,
          "isDeleted": false,
          "boundElements": null,
          "updated": 1,
          "link": null,
          "locked": false,
          "text": "GET    /            [ADMIN] every key and value, as a map\nGET    /:key        [ADMIN]\nPUT    /            [ADMIN] upsert one\nPOST   /bulk        [ADMIN] upsert many\nDELETE /:key        [ADMIN]\nGET    /onboarding  onboarding_step + onboarding_completed\nPUT    /onboarding  move the setup wizard along\nPOST   /upload/logo       [ADMIN] multer + file-validation\nPOST   /upload/stamp      [ADMIN] the stamp on report cards\nPOST   /upload/signature  [ADMIN] the head teacher\n\nGET /school-config/public   PUBLIC, and only four keys:\n   school_name · school_motto · primary_color · logo_url\n   the login screen needs them before any token exists",
          "fontSize": 11,
          "fontFamily": 3,
          "textAlign": "left",
          "verticalAlign": "top",
          "containerId": null,
          "originalText": "GET    /            [ADMIN] every key and value, as a map\nGET    /:key        [ADMIN]\nPUT    /            [ADMIN] upsert one\nPOST   /bulk        [ADMIN] upsert many\nDELETE /:key        [ADMIN]\nGET    /onboarding  onboarding_step + onboarding_completed\nPUT    /onboarding  move the setup wizard along\nPOST   /upload/logo       [ADMIN] multer + file-validation\nPOST   /upload/stamp      [ADMIN] the stamp on report cards\nPOST   /upload/signature  [ADMIN] the head teacher\n\nGET /school-config/public   PUBLIC, and only four keys:\n   school_name · school_motto · primary_color · logo_url\n   the login screen needs them before any token exists",
          "autoResize": true,
          "lineHeight": 1.25
        }
      ]
