          "version": 1,
          "versionNonce": 2088518656,
          "isDeleted": false,
          "boundElements": null,
          "updated": 1,
          "link": null,
          "locked": false,
          "text": "THE SHAPE EVERY MODULE KEEPS.\nsrc/modules/<feature>/ holds a controller, a service, a module,\na dto/ folder of class-validator DTOs, and a colocated spec.\nThey are all registered in app.module.ts. Nothing strays\nfrom that, which is why the board reads the same everywhere.",
          "fontSize": 12,
          "fontFamily": 1,
          "textAlign": "left",
          "verticalAlign": "top",
          "containerId": null,
          "originalText": "THE SHAPE EVERY MODULE KEEPS.\nsrc/modules/<feature>/ holds a controller, a service, a module,\na dto/ folder of class-validator DTOs, and a colocated spec.\nThey are all registered in app.module.ts. Nothing strays\nfrom that, which is why the board reads the same everywhere.",
          "autoResize": true,
          "lineHeight": 1.25
        }
      ]
    },
