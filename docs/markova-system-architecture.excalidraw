      "seed": 1103992320,
      "version": 1,
      "versionNonce": 742198784,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "INCIDENTS\nPOST   /incidents        [ADMIN,TEACHER]\n   date, time, location, description, pointsDeducted\n   → Student.disciplinePoints, which starts at 100\n   actionTaken: VERBAL_WARNING · WRITTEN_WARNING\n   DETENTION · SUSPENSION · EXPULSION\nGET    /incidents        [ADMIN,TEACHER]\nGET    /incidents/:id    [+PARENT, own children only]\nPUT    /incidents/:id · DELETE /incidents/:id [ADMIN]\n   points are re-adjusted when either one happens\nGET    /student/:studentId  [all four roles]\n\nTHE PARENT LOOP\nPOST   /acknowledge         [PARENT] + timestamp\nPOST   /appeals             [PARENT,STUDENT]\n   statement + evidenceUrls[]\nGET    /appeals/pending     [ADMIN]\nPUT    /appeals/:id/review  [ADMIN]\n   APPROVED puts the points back. REJECTED does not.\n\nGET    /dashboard   by type and term, repeat offenders",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "INCIDENTS\nPOST   /incidents        [ADMIN,TEACHER]\n   date, time, location, description, pointsDeducted\n   → Student.disciplinePoints, which starts at 100\n   actionTaken: VERBAL_WARNING · WRITTEN_WARNING\n   DETENTION · SUSPENSION · EXPULSION\nGET    /incidents        [ADMIN,TEACHER]\nGET    /incidents/:id    [+PARENT, own children only]\nPUT    /incidents/:id · DELETE /incidents/:id [ADMIN]\n   points are re-adjusted when either one happens\nGET    /student/:studentId  [all four roles]\n\nTHE PARENT LOOP\nPOST   /acknowledge         [PARENT] + timestamp\nPOST   /appeals             [PARENT,STUDENT]\n   statement + evidenceUrls[]\nGET    /appeals/pending     [ADMIN]\nPUT    /appeals/:id/review  [ADMIN]\n   APPROVED puts the points back. REJECTED does not.\n\nGET    /dashboard   by type and term, repeat offenders",
      "autoResize": true,
      "lineHeight": 1.25
    },
