    {
      "id": "t6xyr2248",
      "type": "text",
      "x": 80,
      "y": 2839,
      "width": 586.9,
      "height": 41.3,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
