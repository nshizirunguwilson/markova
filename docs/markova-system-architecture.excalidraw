      "seed": 265930752,
      "version": 1,
      "versionNonce": 1252677696,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "POST /conversations   ONE_ON_ONE | GROUP | BROADCAST\nGET  /conversations   mine, with last message + unread\nGET  /conversations/:id/messages   paginated history,\n                      participation checked first\nPOST /messages        TEXT | FILE | VOICE, optional\n                      fileUrl, then broadcast on the socket\nPOST /read            writes MessageRead rows\nGET  /unread          the badge count\nGET  /contacts        who this role is allowed to write to\n\na message walks SENT → DELIVERED → READ",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST /conversations   ONE_ON_ONE | GROUP | BROADCAST\nGET  /conversations   mine, with last message + unread\nGET  /conversations/:id/messages   paginated history,\n                      participation checked first\nPOST /messages        TEXT | FILE | VOICE, optional\n                      fileUrl, then broadcast on the socket\nPOST /read            writes MessageRead rows\nGET  /unread          the badge count\nGET  /contacts        who this role is allowed to write to\n\na message walks SENT → DELIVERED → READ",
      "autoResize": true,
      "lineHeight": 1.25
    },
