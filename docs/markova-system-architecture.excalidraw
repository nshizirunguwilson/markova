        {
          "id": "tyflz4cn4",
          "type": "text",
          "x": 1832,
          "y": 10319,
          "width": 402.6,
          "height": 261.3,
          "angle": 0,
          "strokeColor": "#343a40",
          "backgroundColor": "transparent",
