        },
        {
          "id": "t8vfq1ssg",
          "type": "text",
          "x": 823,
          "y": 3748.1000000000004,
          "width": 356.4,
          "height": 288.8,
          "angle": 0,
          "strokeColor": "#343a40",
          "backgroundColor": "transparent",
          "fillStyle": "solid",
          "strokeWidth": 1,
          "strokeStyle": "solid",
          "roughness": 1,
