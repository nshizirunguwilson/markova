      "text": "marker fill (hachure) means it holds data.   a dashed edge means it is optional or not wired.   ★ marks the ideas that carry the design.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "marker fill (hachure) means it holds data.   a dashed edge means it is optional or not wired.   ★ marks the ideas that carry the design.",
      "autoResize": true,
      "lineHeight": 1.25
    },
