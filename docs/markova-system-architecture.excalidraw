          "groupIds": [
            "g6squpmbk"
          ],
          "frameId": null,
          "roundness": null,
          "seed": 924748288,
          "version": 1,
          "versionNonce": 34402816,
          "isDeleted": false,
          "boundElements": null,
          "updated": 1,
          "link": null,
          "locked": false,
          "text": "handshake   client.handshake.auth.token → JwtService.verify\nrooms       user:<userId>, always joined\n            conv:<conversationId>, joined on demand\n\nclient → server   sendMessage · markRead · typing\n                  stopTyping · joinConversation\nserver → client   newMessage · messageDelivered · messagesRead\n                  userTyping · userStopTyping · onlineUsers\n                  presenceChange\n\npresence    an in-memory Map of userId → Set<socketId>\nrate limit  30 messages a minute, per user\nceiling     maxHttpBufferSize 1 MB",
          "fontSize": 11,
          "fontFamily": 3,
          "textAlign": "left",
          "verticalAlign": "top",
          "containerId": null,
          "originalText": "handshake   client.handshake.auth.token → JwtService.verify\nrooms       user:<userId>, always joined\n            conv:<conversationId>, joined on demand\n\nclient → server   sendMessage · markRead · typing\n                  stopTyping · joinConversation\nserver → client   newMessage · messageDelivered · messagesRead\n                  userTyping · userStopTyping · onlineUsers\n                  presenceChange\n\npresence    an in-memory Map of userId → Set<socketId>\nrate limit  30 messages a minute, per user\nceiling     maxHttpBufferSize 1 MB",
          "autoResize": true,
          "lineHeight": 1.25
        }
      ]
    },
