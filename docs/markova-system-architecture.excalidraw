      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "the refresh token ROTATES. a Redis lock refresh_lock:<id>\nmakes it single flight, and a second use of the same token\nis read as a replay and kills the whole session.\nThe web client mirrors that with one shared promise.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the refresh token ROTATES. a Redis lock refresh_lock:<id>\nmakes it single flight, and a second use of the same token\nis read as a replay and kills the whole session.\nThe web client mirrors that with one shared promise.",
      "autoResize": true,
      "lineHeight": 1.25
    },
