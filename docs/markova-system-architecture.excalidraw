          "versionNonce": 1897127168,
          "isDeleted": false,
          "boundElements": null,
          "updated": 1,
          "link": null,
          "locked": false,
          "text": "These two crons are the entire background story.\n@nestjs/bullmq and bullmq are both installed, but there is no BullModule,\nno Queue and no @Processor anywhere in backend/src. Everything else that\nlooks asynchronous is an inline await inside the request that triggered it.",
          "fontSize": 12,
          "fontFamily": 1,
          "textAlign": "left",
          "verticalAlign": "top",
          "containerId": null,
          "originalText": "These two crons are the entire background story.\n@nestjs/bullmq and bullmq are both installed, but there is no BullModule,\nno Queue and no @Processor anywhere in backend/src. Everything else that\nlooks asynchronous is an inline await inside the request that triggered it.",
          "autoResize": true,
          "lineHeight": 1.25
        }
      ]
    },
