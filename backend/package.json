{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "uploads:per-school": "ts-node -r dotenv/config --compiler-options '{\"module\":\"CommonJS\"}' src/scripts/move-uploads-per-school.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.17",
    "@prisma/client": "^6.19.2",
    "@sentry/nestjs": "^9.0.0",
    "@sentry/node": "^9.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^10.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.2",
    "puppeteer-core": "^25.13.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.13.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!uuid)"
    ],
    "//coverageThreshold": [
      "A ratchet, not a target: set just under the measured figures so an",
      "accidental deletion of tests fails the build, and meant to be raised as",
      "coverage climbs, never lowered to make a build pass.",
      "",
      "Branches reads lower than the rest and cannot reach 97. Of the 3552",
      "counted branches, 872 are not in any TypeScript anyone wrote: they are",
      "the `typeof X === undefined ? Object : X` expressions the compiler emits",
      "for emitDecoratorMetadata on every @Body(), @Query() and DTO field. Nest",
      "needs that flag for dependency injection and no test can take the other",
      "arm, because the type is always defined at runtime. 312 of them are",
      "permanently uncoverable, which caps the reported figure near 93.",
      "",
      "Measured against branches that exist in the source, coverage is 97.01%.",
      "Measured 99.09 / 91.21 / 97.78 / 99.14 on 25 August 2026."
    ],
    "coverageThreshold": {
      "global": {
        "statements": 98,
        "branches": 90,
        "functions": 97,
        "lines": 98
      }
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "moduleNameMapper": {
      "^puppeteer-core$": "<rootDir>/__test__/puppeteer-stub.ts"
    }
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "overridesComment": "deepmerge-ts is pinned because the prisma CLI pulls version 7, which has a prototype pollution advisory. Version 8 is compatible. @opentelemetry/core is deliberately NOT pinned: Sentry ships a coordinated set of @opentelemetry packages, and forcing one of them out of that set makes the SDK fail to load at boot with 'Cannot read properties of undefined (reading AlwaysOn)'. Its advisory is carried in scripts/check-vulnerabilities.mjs instead."
}
