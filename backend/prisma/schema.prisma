model ExamSchedule {
  id             String   @id @default(uuid())
  schoolId       String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classSectionId String   @map("class_section_id")
  subjectId      String   @map("subject_id")
  termId         String   @map("term_id")
  examDate       DateTime @map("exam_date") @db.Date
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  room           String?
  syllabus       String?
  createdAt      DateTime @default(now()) @map("created_at")

  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([classSectionId, termId])
  @@index([examDate])
  @@index([schoolId])
  @@map("exam_schedules")
}

model FaqArticle {
  id           String  @id @default(uuid())
  schoolId     String  @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  title        String
  content      String
  category     String?
  displayOrder Int     @default(0) @map("display_order")
  isPublished  Boolean @default(true) @map("is_published")

  @@index([category])
  @@index([schoolId])
  @@map("faq_articles")
}

// ═══════════════════════════════════════════════════════════════════════════
// POCKET MONEY
//
// The school holds a child's money, so this is a trust ledger rather than a
// wallet. Nothing is ever edited or deleted: a correction is a reversing
// entry, and the balance is the sum of the entries. A stored balance that
// drifts from its transactions is how money disappears.
// ═══════════════════════════════════════════════════════════════════════════

enum PocketMoneyKind {
  /// A parent hands money in, usually on visiting day.
  DEPOSIT
  /// The student draws it at the canteen or the counter.
  WITHDRAWAL
  /// Money returned to the family, typically at the end of a year.
  REFUND
  /// Undoes an earlier entry. The original is never touched.
  REVERSAL
  /// Corrects a counting error found at reconciliation.
  ADJUSTMENT
}

model PocketMoneyAccount {
  id              String   @id @default(uuid())
  schoolId        String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId       String   @unique @map("student_id")
  /// What the student may spend in one day. Set by the parent, because it is
  /// their money and a term's money has to last a term. Null means no cap.
  dailyLimit      Float?   @map("daily_limit")
  /// Below this the parent is told. Null means never.
  lowBalanceAlert Float?   @map("low_balance_alert")
  isFrozen        Boolean  @default(false) @map("is_frozen")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  student      Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transactions PocketMoneyTransaction[]

  @@index([schoolId])
  @@map("pocket_money_accounts")
}

model PocketMoneyTransaction {
  id               String          @id @default(uuid())
  schoolId         String          @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school           School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  accountId        String          @map("account_id")
  kind             PocketMoneyKind
  /// Always positive. The kind decides the direction, so a reader never has to
  /// work out whether a negative deposit means a refund.
  amount           Float
  note             String?
  /// Who was at the counter. Null only for entries the system makes itself.
  recordedByUserId String?         @map("recorded_by_user_id")
  /// The entry this one undoes, for a REVERSAL.
  reversesId       String?         @unique @map("reverses_id")
  /// The key the client sent, so a retried deposit does not become two.
  idempotencyKey   String?         @unique @map("idempotency_key")
  createdAt        DateTime        @default(now()) @map("created_at")

  account    PocketMoneyAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recordedBy User?                   @relation("PocketMoneyRecordedBy", fields: [recordedByUserId], references: [id])
  reverses   PocketMoneyTransaction? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy PocketMoneyTransaction? @relation("Reversal")

  @@index([accountId, createdAt])
  @@index([schoolId])
  @@map("pocket_money_transactions")
}

// ═══════════════════════════════════════════════════════════════════════════
// ACTIVITIES AND EVENTS
//
// A head teacher's week is not lessons. It is visiting day, an inter-school
// match, a club that meets on Wednesday, and a trip that needs a bus and
// thirty signed permission slips. All of that lives in a paper diary today.
// ═══════════════════════════════════════════════════════════════════════════

enum ActivityKind {
  /// Meets regularly: debate, drama, scouts, choir.
  CLUB
  /// Football, athletics, an inter-school match.
  SPORT
  /// Whole-school gathering.
  ASSEMBLY
  /// Off the premises. Needs consent, and needs a list of exactly who went.
  TRIP
  /// The day of the month that matters most to a boarder.
  VISITING_DAY
  /// Exams, prize-giving, parents' evening.
  SCHOOL_EVENT
}

enum ActivityAudience {
  /// Everybody.
  WHOLE_SCHOOL
  /// Named year levels, e.g. all of Senior 1.
  LEVELS
  /// Named classes.
  CLASSES
}

model Activity {
  id               String           @id @default(uuid())
  schoolId         String           @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  kind             ActivityKind
  title            String
  description      String?
  location         String?
  startsAt         DateTime         @map("starts_at")
  endsAt           DateTime?        @map("ends_at")
  audience         ActivityAudience @default(WHOLE_SCHOOL)
  /// A trip off the premises needs recorded consent; an assembly does not.
  requiresConsent  Boolean          @default(false) @map("requires_consent")
  /// A club meeting takes a register; an assembly does not.
  tracksAttendance Boolean          @default(false) @map("tracks_attendance")
  /// Null means no cap.
  capacity         Int?
  isCancelled      Boolean          @default(false) @map("is_cancelled")
  cancelledReason  String?          @map("cancelled_reason")

  createdByUserId String   @map("created_by_user_id")
  termId          String?  @map("term_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy    User                  @relation("ActivityCreatedBy", fields: [createdByUserId], references: [id])
  term         Term?                 @relation(fields: [termId], references: [id])
  classLevels  ActivityClassLevel[]
  sections     ActivitySection[]
  participants ActivityParticipant[]

  @@index([startsAt])
  @@index([schoolId])
  @@map("activities")
}

/// Which year levels an activity concerns, when the audience is LEVELS.
model ActivityClassLevel {
  id           String @id @default(uuid())
  schoolId     String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school       School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  activityId   String @map("activity_id")
  classLevelId String @map("class_level_id")

  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@unique([activityId, classLevelId])
  @@index([schoolId])
  @@map("activity_class_levels")
}

/// Which classes an activity concerns, when the audience is CLASSES.
model ActivitySection {
  id             String @id @default(uuid())
  schoolId       String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school         School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  activityId     String @map("activity_id")
  classSectionId String @map("class_section_id")

  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  @@unique([activityId, classSectionId])
  @@index([schoolId])
  @@map("activity_sections")
}

enum ConsentState {
  /// Nobody has answered yet.
  PENDING
  GIVEN
  REFUSED
}

/// One student's place in one activity.
///
/// Consent and attendance live together because they answer the same question
/// from two sides: may this child go, and did they.
model ActivityParticipant {
  id         String @id @default(uuid())
  schoolId   String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school     School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  activityId String @map("activity_id")
  studentId  String @map("student_id")

  consent         ConsentState @default(PENDING)
  consentByUserId String?      @map("consent_by_user_id")
  consentAt       DateTime?    @map("consent_at")
  consentNote     String?      @map("consent_note")

  /// Null until the register is taken.
  attended   Boolean?  @map("attended")
  attendedAt DateTime? @map("attended_at")

  createdAt DateTime @default(now()) @map("created_at")

  activity  Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  consentBy User?    @relation("ActivityConsentBy", fields: [consentByUserId], references: [id])

  @@unique([activityId, studentId])
  @@index([studentId])
  @@index([schoolId])
  @@map("activity_participants")
}

// ─── HEALTH ───────────────────────────────────────────────────────────────────
// A boarding school is responsible for a child's body as well as their marks.
// The sick bay currently runs on an exercise book, which means nobody can
// answer "how many times has she been in this term" or "did she get her second
// dose", and a parent finds out their child was ill when they collect them.

enum ClinicVisitOutcome {
  /// Seen, treated, sent back to class or the dormitory.
  RETURNED_TO_CLASS
  /// Kept in the sick bay to rest.
  RESTING_IN_SICK_BAY
  /// Sent to a health centre or hospital.
  REFERRED_OUT
  /// Collected by a parent.
  SENT_HOME
}

enum ClinicSeverity {
  MINOR
  MODERATE
  SERIOUS
}

/// One visit to the sick bay.
///
/// Nothing here is ever deleted. A health record that can be tidied away is
/// worth nothing the day somebody has to account for what happened.
model ClinicVisit {
  id        String @id @default(uuid())
  schoolId  String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId String @map("student_id")

  /// What the student said was wrong, in their words.
  complaint String
  /// What the nurse found.
  findings  String?
  treatment String?
  severity  ClinicSeverity     @default(MINOR)
  outcome   ClinicVisitOutcome @default(RETURNED_TO_CLASS)

  temperature Float?
  /// Where they were sent, when the outcome is REFERRED_OUT.
  referredTo  String? @map("referred_to")

  seenByUserId String    @map("seen_by_user_id")
  visitedAt    DateTime  @default(now()) @map("visited_at")
  /// Set when a student kept in the sick bay is discharged.
  dischargedAt DateTime? @map("discharged_at")

  /// Whether the family has been told. A parent should never learn from their
  /// child that the school kept them in the sick bay overnight.
  parentNotifiedAt DateTime? @map("parent_notified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student     Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  seenBy      User                       @relation("ClinicSeenBy", fields: [seenByUserId], references: [id])
  medications MedicationAdministration[]

  @@index([studentId])
  @@index([visitedAt])
  @@index([schoolId])
  @@map("clinic_visits")
}

/// Every dose given, with who gave it and when.
///
/// This is the row that answers "has she already had her paracetamol today",
/// which is the question a double dose comes from.
model MedicationAdministration {
  id        String  @id @default(uuid())
  schoolId  String  @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId String  @map("student_id")
  /// The visit it came out of, when there was one. Regular medication for a
  /// long-term condition has no visit behind it.
  visitId   String? @map("visit_id")

  medicine String
  dose     String
  reason   String?

  givenByUserId String   @map("given_by_user_id")
  givenAt       DateTime @default(now()) @map("given_at")

  createdAt DateTime @default(now()) @map("created_at")

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  visit   ClinicVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  givenBy User         @relation("MedicationGivenBy", fields: [givenByUserId], references: [id])

  @@index([studentId])
  @@index([givenAt])
  @@index([schoolId])
  @@map("medication_administrations")
}

/// The one page somebody needs at three in the morning.
///
/// Separate from Student because it is read under different rules: the nurse,
/// the boarding staff and the office see it, teachers never do.
model StudentHealthRecord {
  id        String @id @default(uuid())
  schoolId  String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId String @unique @map("student_id")

  /// Long-term conditions in plain words: asthma, epilepsy, sickle cell.
  chronicConditions String? @map("chronic_conditions")
  /// Medication taken regularly, and when.
  regularMedication String? @map("regular_medication")
  /// Anything the school must never give them.
  allergyNotes      String? @map("allergy_notes")
  /// Free text: what a fit looks like for this child, where the inhaler is.
  emergencyPlan     String? @map("emergency_plan")

  /// Who to ring first, which is not always the parent on the account.
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  emergencyRelationship String? @map("emergency_relationship")

  /// Mutuelle de Sante or other cover, needed at the health centre gate.
  insuranceProvider String? @map("insurance_provider")
  insuranceNumber   String? @map("insurance_number")

  /// The health centre the school refers to for this child.
  preferredClinic String? @map("preferred_clinic")

  updatedByUserId String?  @map("updated_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("HealthRecordUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([schoolId])
  @@map("student_health_records")
}

/// What a merit was earned for.
///
/// Named for the things a Rwandan secondary school already praises at
/// assembly, so staff recognise the list rather than translating into it.
enum MeritCategory {
  /// Real effort in class, whatever the mark came out as.
  ACADEMIC_EFFORT
  HELPING_OTHERS
  LEADERSHIP
  SPORT
  ARTS
  /// Work for the school itself: the garden, the library, the dormitory.
  SERVICE
  HONESTY
  /// Turning it around. The one that matters most to a student on a warning.
  IMPROVEMENT
}

/// Points earned back, and recognition kept.
///
/// A conduct system with only deductions teaches a student that the best
/// possible outcome is to be unnoticed. Merits give the school a way to say
/// the opposite, and give a student on a warning a visible way back.
model MeritAward {
  id              String        @id @default(uuid())
  schoolId        String        @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId       String        @map("student_id")
  termId          String        @map("term_id")
  awardedByUserId String        @map("awarded_by_user_id")
  category        MeritCategory
  description     String
  /// Added back to the conduct score, which is capped at a clean sheet. The
  /// recognition itself is not capped: the award stands on the record whether
  /// or not there were points left to restore.
  points          Int
  date            DateTime      @db.Date
  createdAt       DateTime      @default(now()) @map("created_at")

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  awardedBy User    @relation("MeritAwardedBy", fields: [awardedByUserId], references: [id])

  @@index([studentId])
  @@index([termId])
  @@index([schoolId])
  @@map("merit_awards")
}

// ═══════════════════════════════════════════════════════════════════════════
// SCHOOL FEES
//
// The ledger a Rwandan school actually keeps: what each family was asked for
// this term, what has come in against it, and what the school has written off.
// It lives in a cash book and a bursar's head today, which is why nobody can
// answer "how much is left on Rose's account" without finding the bursar.
//
// Three rules, the same ones the pocket money ledger follows, and for the
// same reason - it is somebody else's money:
//
//  - **A balance is derived, never stored.** It is the invoice total less what
//    has been paid and what has been waived. A stored balance that drifts from
//    its entries is how money disappears.
//  - **Nothing is edited or deleted.** A receipt entered twice is voided, with
//    a reason and a name against it, so the book stands up months later.
//  - **What was charged is frozen when it is charged.** Next year's prices
//    must never rewrite what a family was asked for last year.
// ═══════════════════════════════════════════════════════════════════════════

/// Who a fee line is charged to.
///
/// A boarder pays for a bed and for meals; a day student pays for the bus.
/// Holding this on the line rather than in two parallel fee tables means one
/// structure describes the whole class and each student's total falls out of
/// where they sleep.
enum FeeAppliesTo {
  ALL
  BOARDER
  DAY
}

/// How money reached the school.
///
/// Recorded because reconciling a bank statement against a cash book is the
/// bursar's month-end, and "paid" without a method or a reference is exactly
/// what makes that impossible.
enum PaymentMethod {
  CASH
  BANK_DEPOSIT
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
}

/// Why a family is not being asked for part of the fee.
///
/// Named rather than a free-text note, because the school is asked every year
/// how many children it carries and on what grounds.
enum WaiverKind {
  /// The school's own bursary, means-tested.
  BURSARY
  /// Merit: a place earned rather than bought.
  SCHOLARSHIP
  /// A district, government or NGO sponsor pays instead of the family.
  SPONSORSHIP
  /// A one-off remission after a bereavement, a fire, a lost harvest.
  HARDSHIP
  /// Staff children, and the second and third child of one family.
  STAFF_CHILD
}

/// One line the school charges a class level for, in one term.
///
/// The price list, not the bill. Editing this changes what future invoices
/// are raised at and leaves every invoice already issued untouched.
model FeeItem {
  id           String       @id @default(uuid())
  schoolId     String       @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  termId       String       @map("term_id")
  classLevelId String       @map("class_level_id")
  name         String
  /// Rwandan francs.
  amount       Float
  appliesTo    FeeAppliesTo @default(ALL)
  /// Where the line sits on a printed invoice. Tuition first, extras last.
  position     Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  term       Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@unique([termId, classLevelId, name])
  @@index([termId])
  @@index([schoolId])
  @@map("fee_items")
}

/// What one student was asked for, for one term.
///
/// Raised from the fee items and then frozen: the lines are copied, not
/// referenced, so a price changed in March cannot rewrite a bill sent in
/// January. One per student per term, which is what makes "cleared for this
/// term" a question with a single answer.
model FeeInvoice {
  id        String   @id @default(uuid())
  schoolId  String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId String   @map("student_id")
  termId    String   @map("term_id")
  /// The sum of the lines, held so a list of five hundred students does not
  /// have to add up five hundred sets of lines to draw one column.
  total     Float
  issuedAt  DateTime @default(now()) @map("issued_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  lines    FeeInvoiceLine[]
  payments FeePayment[]
  waivers  FeeWaiver[]

  @@unique([studentId, termId])
  @@index([termId])
  @@index([schoolId])
  @@map("fee_invoices")
}

/// A line as it stood when the invoice was raised.
model FeeInvoiceLine {
  id        String @id @default(uuid())
  schoolId  String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school    School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  invoiceId String @map("invoice_id")
  name      String
  amount    Float
  position  Int    @default(0)

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([schoolId])
  @@map("fee_invoice_lines")
}

/// Money received against an invoice.
///
/// Never edited and never deleted. A receipt entered twice is voided, which
/// leaves both the entry and the reason in the book - the correction a bursar
/// can show an auditor, rather than a row that quietly went missing.
model FeePayment {
  id               String        @id @default(uuid())
  schoolId         String        @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school           School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  invoiceId        String        @map("invoice_id")
  /// Printed on the receipt and quoted by the family ever after, so it is
  /// unique across the school and never reused.
  receiptNumber    String        @map("receipt_number")
  /// Rwandan francs, always positive.
  amount           Float
  method           PaymentMethod
  /// The bank slip number, the MoMo transaction id, the cheque number. What
  /// makes this entry findable in somebody else's records.
  reference        String?
  /// When the money changed hands, which is not when it was typed in.
  paidAt           DateTime      @map("paid_at")
  note             String?
  /// Who took it. Null only for entries the system makes itself.
  recordedByUserId String?       @map("recorded_by_user_id")

  /// The key the client sent with this payment, so a repeat of the same
  /// request returns the same receipt instead of taking the money twice.
  ///
  /// A parent on a poor connection taps pay, sees nothing happen, and taps
  /// again; a client that times out retries. Both produce two records of one
  /// payment, and the second is only found when somebody reconciles the books.
  /// Unique, so the database refuses the duplicate even if two requests arrive
  /// at the same instant on two different servers.
  idempotencyKey String? @unique @map("idempotency_key")

  /// A voided receipt stops counting towards the balance but stays in the
  /// book. All three fields are set together or none of them are.
  voidedAt       DateTime? @map("voided_at")
  voidedByUserId String?   @map("voided_by_user_id")
  voidReason     String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at")

  invoice    FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?      @relation("FeePaymentRecordedBy", fields: [recordedByUserId], references: [id])
  voidedBy   User?      @relation("FeePaymentVoidedBy", fields: [voidedByUserId], references: [id])

  @@unique([schoolId, receiptNumber])
  @@index([invoiceId, paidAt])
  @@map("fee_payments")
}

/// Part of an invoice the school has decided not to collect.
///
/// Counts towards clearing the term exactly as a payment does. Without it a
/// sponsored child could never be shown their own results, and the only way
/// round would be to record a payment that never happened - which is worse
/// than the problem.
model FeeWaiver {
  id              String     @id @default(uuid())
  schoolId        String     @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school          School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  invoiceId       String     @map("invoice_id")
  kind            WaiverKind
  /// Rwandan francs. A full bursary is the invoice total; there is no
  /// separate "everything" flag, so the arithmetic is the same either way.
  amount          Float
  /// Required. An unexplained write-off is indistinguishable from a mistake.
  reason          String
  grantedByUserId String?    @map("granted_by_user_id")

  /// Withdrawn rather than deleted, for the same reason a receipt is voided.
  revokedAt       DateTime? @map("revoked_at")
  revokedByUserId String?   @map("revoked_by_user_id")
  revokeReason    String?   @map("revoke_reason")

  createdAt DateTime @default(now()) @map("created_at")

  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  grantedBy User?      @relation("FeeWaiverGrantedBy", fields: [grantedByUserId], references: [id])
  revokedBy User?      @relation("FeeWaiverRevokedBy", fields: [revokedByUserId], references: [id])

  @@index([invoiceId])
  @@index([schoolId])
  @@map("fee_waivers")
}

// ═══════════════════════════════════════════════════════════════════════════
// ADMISSIONS
//
// Where a family's application from the public site becomes a decision, and a
// decision becomes a student.
//
// Two rules shape every model here, and both come from the same place: an
// admissions record is evidence. A family that is turned away will ask why,
// sometimes a year later, and the school has to be able to answer.
//
//  - **Nothing is ever deleted.** A rejection is a state with a reason and a
//    name against it, not a missing row. The same rule the fee ledger follows.
//  - **The school's clock and the family's are different.** Reviewing is the
//    school's business; accepting or declining an offer is the family's. They
//    are two records, so neither can overwrite the other.
//
// An application is deliberately shaped like a Student without being one. It
// is what the family *claimed*; a student record is what the school *holds*,
// and correcting a misspelt village at enrolment must not rewrite what was
// submitted.
// ═══════════════════════════════════════════════════════════════════════════

/// Which door a family is coming through. The three are genuinely different
/// applications: a transfer has no national exam slip, and a Senior 1 entrant
/// has no trade to choose.
enum AdmissionEntryPoint {
  /// Leaving P6, entering the first year of secondary.
  SENIOR_ONE
  /// Finished O-Level, entering A-Level or a TVET trade level.
  ADVANCED_LEVEL
  /// Moving school mid-stream, at any level.
  TRANSFER
}

/// Where an application stands.
///
/// Nine, and each one exists because somebody would otherwise have to keep the
/// difference in their head. See `admissions-state.ts` for what may follow what.
enum ApplicationStatus {
  /// Arrived, nobody has looked. The count of these is the school's backlog.
  SUBMITTED
  /// Somebody has it. Stops two officers working the same family.
  UNDER_REVIEW
  /// Waiting on the family. The school's clock stops here, so its own queue
  /// ages do not read as its own delay.
  INFO_REQUESTED
  /// Good enough, no place. Rejecting them loses the list the school needs the
  /// day somebody declines an offer.
  WAITLISTED
  /// A place is held, with an expiry. Held capacity, and visible as such.
  OFFERED
  /// The family said yes. Separate from ENROLLED because the office still has
  /// work to do.
  ACCEPTED
  /// A real student record exists. The only state that has written rows
  /// outside admissions.
  ENROLLED
  /// The school said no. Carries a reason, because the school will be asked.
  REJECTED
  /// The family stopped. Not a rejection, and reporting the two together is
  /// how a school comes to believe it turns away more children than it does.
  WITHDRAWN
}

/// What a family attaches. An enum rather than free text, so "what is still
/// missing" is computable rather than remembered.
enum AdmissionDocumentKind {
  BIRTH_CERTIFICATE
  NATIONAL_EXAM_RESULT
  PREVIOUS_REPORT_CARD
  TRANSFER_LETTER
  PASSPORT_PHOTO
  PARENT_ID
  MEDICAL_FORM
  INSURANCE_CARD
  BURSARY_LETTER
  OTHER
}

/// How a family says they will pay, declared at application. What they declare
/// becomes a waiver on their first invoice for the office to confirm.
enum AdmissionFunding {
  FAMILY
  DISTRICT_BURSARY
  GOVERNMENT_SPONSORED
  NGO_SPONSOR
  FARG
  STAFF_CHILD
}

/// An admissions round: one entry point, one class level, one year.
///
/// Where places finally live. `ClassSection` has never carried a capacity, and
/// admissions is the first feature that genuinely needs one - an offer against
/// unknown capacity is a guess. It sits here rather than on the class because
/// an intake is where a school actually thinks about how many it can take.
model AdmissionIntake {
  id             String              @id @default(uuid())
  schoolId       String              @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String              @map("academic_year_id")
  classLevelId   String              @map("class_level_id")
  entryPoint     AdmissionEntryPoint @map("entry_point")
  /// Shown to families: "Senior 1 intake, 2026".
  name           String
  /// How many the school can take. Offers outstanding count against it.
  places         Int
  opensAt        DateTime            @map("opens_at")
  closesAt       DateTime            @map("closes_at")
  isOpen         Boolean             @default(true) @map("is_open")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel   @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  applications Application[]

  @@unique([academicYearId, classLevelId, entryPoint])
  @@index([isOpen])
  @@index([schoolId])
  @@map("admission_intakes")
}

/// One family's application.
///
/// The columns mirror `Student` almost one for one, and that is not
/// duplication: this is what was claimed, and a student record is what the
/// school holds. The two have to be able to differ.
model Application {
  id        String            @id @default(uuid())
  schoolId  String            @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  intakeId  String            @map("intake_id")
  /// `APP-2026-0417`. Quoted by the family for months, so it is unique across
  /// the school and never reused. Deliberately not a student number: holding
  /// one of those would imply they got in.
  reference String            @unique
  status    ApplicationStatus @default(SUBMITTED)

  // ── the applicant ─────────────────────────────────────────────────────
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  dateOfBirth DateTime @map("date_of_birth")
  gender      Gender
  nationality String?
  /// NIDA, for an applicant old enough to hold one.
  nationalId  String?  @map("national_id")

  // ── where they live, the standard five-level Rwandan address ──────────
  province String?
  district String?
  sector   String?
  cell     String?
  village  String?

  // ── school history ────────────────────────────────────────────────────
  previousSchool      String? @map("previous_school")
  /// The national exam mark, out of the total that exam is marked from.
  examMark            Float?  @map("exam_mark")
  examTotal           Float?  @map("exam_total")
  /// For an A-Level or TVET application: the trade they want, and a fallback.
  tradeId             String? @map("trade_id")
  secondChoiceTradeId String? @map("second_choice_trade_id")

  // ── what they are asking for ──────────────────────────────────────────
  isBoarder     Boolean          @default(false) @map("is_boarder")
  funding       AdmissionFunding @default(FAMILY)
  /// Named when the funding is anything but the family paying.
  fundingDetail String?          @map("funding_detail")

  // ── welfare, the fields the sick bay and the register need on day one ──
  bloodType         String? @map("blood_type")
  allergies         String?
  medicalConditions String? @map("medical_conditions")
  disability        String?
  insuranceNumber   String? @map("insurance_number")
  religion          String?

  // ── who to talk to ────────────────────────────────────────────────────
  guardianName        String  @map("guardian_name")
  guardianPhone       String  @map("guardian_phone")
  guardianEmail       String? @map("guardian_email")
  guardianNationalId  String? @map("guardian_national_id")
  guardianRelation    String  @map("guardian_relation")
  secondGuardianName  String? @map("second_guardian_name")
  secondGuardianPhone String? @map("second_guardian_phone")

  /// Anything the family wanted the school to know.
  note String?

  // ── what became of it ─────────────────────────────────────────────────
  submittedAt DateTime  @default(now()) @map("submitted_at")
  decidedAt   DateTime? @map("decided_at")
  /// Set once ENROLLED. The application is frozen from then on.
  studentId   String?   @unique @map("student_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  intake            AdmissionIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  trade             Trade?          @relation("ApplicationTrade", fields: [tradeId], references: [id])
  secondChoiceTrade Trade?          @relation("ApplicationSecondChoice", fields: [secondChoiceTradeId], references: [id])
  student           Student?        @relation(fields: [studentId], references: [id])

  documents ApplicationDocument[]
  events    ApplicationEvent[]
  notes     ApplicationNote[]
  offers    AdmissionOffer[]

  @@index([intakeId, status])
  @@index([status, submittedAt])
  @@index([guardianPhone])
  @@index([schoolId])
  @@map("applications")
}

/// One file a family attached.
model ApplicationDocument {
  id               String                @id @default(uuid())
  schoolId         String                @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  applicationId    String                @map("application_id")
  kind             AdmissionDocumentKind
  fileUrl          String                @map("file_url")
  fileName         String                @map("file_name")
  /// The office has opened it and confirmed it is what it claims to be.
  verifiedAt       DateTime?             @map("verified_at")
  verifiedByUserId String?               @map("verified_by_user_id")
  uploadedAt       DateTime              @default(now()) @map("uploaded_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedBy  User?       @relation("ApplicationDocVerifiedBy", fields: [verifiedByUserId], references: [id])

  @@index([applicationId])
  @@index([schoolId])
  @@map("application_documents")
}

/// Every state change, with who, when and why.
///
/// The audit trail, and what an appeal is answered from. A decision is
/// reversible until it is communicated and after that only by an explicit
/// reversal, which is itself one of these rows.
model ApplicationEvent {
  id            String             @id @default(uuid())
  schoolId      String             @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school        School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  applicationId String             @map("application_id")
  /// Null for the row that records the application arriving.
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  /// Required on anything a family could be told about. An unexplained
  /// decision is indistinguishable from a mistake.
  reason        String?
  /// Null for what the family did, and for what the system did itself.
  actorUserId   String?            @map("actor_user_id")
  createdAt     DateTime           @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation("ApplicationEventActor", fields: [actorUserId], references: [id])

  @@index([applicationId, createdAt])
  @@index([schoolId])
  @@map("application_events")
}

/// An internal remark. Never shown to the family, and the screen says so.
model ApplicationNote {
  id            String   @id @default(uuid())
  schoolId      String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  applicationId String   @map("application_id")
  body          String
  authorUserId  String   @map("author_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation("ApplicationNoteAuthor", fields: [authorUserId], references: [id])

  @@index([applicationId, createdAt])
  @@index([schoolId])
  @@map("application_notes")
}

/// A place held for a family, with an expiry and an answer.
///
/// Its own record rather than a status, because the school's clock and the
/// family's are different: the school offers, the family answers, and neither
/// should be able to overwrite the other. An offer that expires unanswered is
/// a third outcome again.
model AdmissionOffer {
  id             String   @id @default(uuid())
  schoolId       String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  applicationId  String   @map("application_id")
  /// The class the place is in. Named on the offer rather than guessed at
  /// enrolment, because a family accepts a specific place.
  classSectionId String   @map("class_section_id")
  isBoarder      Boolean  @default(false) @map("is_boarder")
  /// What the family is told the term will cost, taken from the fee structure
  /// at the moment of offering.
  termFee        Float?   @map("term_fee")
  /// Anything conditional: "subject to the original results slip".
  conditions     String?
  expiresAt      DateTime @map("expires_at")

  offeredByUserId String   @map("offered_by_user_id")
  offeredAt       DateTime @default(now()) @map("offered_at")

  /// The family's answer, and when. Null while the offer stands.
  acceptedAt    DateTime? @map("accepted_at")
  declinedAt    DateTime? @map("declined_at")
  declineReason String?   @map("decline_reason")
  /// Withdrawn by the school before the family answered.
  revokedAt     DateTime? @map("revoked_at")
  revokeReason  String?   @map("revoke_reason")

  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id])
  offeredBy    User         @relation("AdmissionOfferedBy", fields: [offeredByUserId], references: [id])

  @@index([applicationId])
  @@index([expiresAt])
  @@index([schoolId])
  @@map("admission_offers")
}
