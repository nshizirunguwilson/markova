generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  LIBRARIAN
  /// Boys' boarding master. Runs the dormitories, holds pocket money, and
  /// takes students to the clinic. A real role in a Rwandan boarding school,
  /// not an administrator with extra duties.
  PATRON
  /// Girls' boarding mistress. The same duties, for the girls' side.
  MATRON
  /// School nurse. Sees health records; sees nothing academic.
  NURSE
}

enum SpecialRole {
  DOS
  HOD
  CLASS_TEACHER
}

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  CONTRACT
}

// Rwandan teaching credential levels: A0 bachelor's, A1 diploma, A2 secondary.
enum TeacherQualification {
  A0
  A1
  A2
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
}

enum Gender {
  MALE
  FEMALE
}

enum EducationStage {
  O_LEVEL
  A_LEVEL
}

enum SubjectScope {
  O_CORE
  O_ELECTIVE
  A_GENERAL
  A_SPECIFIC
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AbsenceReason {
  SICK
  FAMILY
  PERMISSION
  UNEXCUSED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
  DAMAGED
}

enum DisciplineAction {
  VERBAL_WARNING
  WRITTEN_WARNING
  DETENTION
  SUSPENSION
  EXPULSION
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationType {
  ONE_ON_ONE
  GROUP
  BROADCAST
}

enum MessageContentType {
  TEXT
  FILE
  VOICE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  SMS
  EMAIL
  PUSH
}

// ─── CORE ───────────────────────────────────────────────────────────────────────

model SchoolConfig {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("school_configs")
}

model User {
  id                  String    @id @default(uuid())
  email               String?   @unique
  phone               String?   @unique
  // Role-based registration code for staff and parents (TCH/PAR/LIB/ADM).
  // Students carry theirs on Student.studentIdNumber (STD prefix).
  code                String?   @unique
  // NIDA 16-digit national identification number (stored without spaces).
  nationalId          String?   @unique @map("national_id")
  nationality         String?
  // For staff and parents. Students carry theirs on Student, which stays
  // the single source of truth for student demographics.
  gender              Gender?
  dateOfBirth         DateTime? @map("date_of_birth")
  passwordHash        String?   @map("password_hash")
  role                Role
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  photoUrl            String?   @map("photo_url")
  isActive            Boolean   @default(true) @map("is_active")
  forcePasswordChange Boolean   @default(true) @map("force_password_change")
  lastLoginAt         DateTime? @map("last_login_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  sessions                UserSession[]
  auditLogs               AuditLog[]
  pocketMoneyEntries      PocketMoneyTransaction[]   @relation("PocketMoneyRecordedBy")
  activitiesCreated       Activity[]                 @relation("ActivityCreatedBy")
  activityConsents        ActivityParticipant[]      @relation("ActivityConsentBy")
  student                 Student?
  teacher                 Teacher?
  parentStudents          ParentStudent[]
  markedAttendances       Attendance[]               @relation("MarkedByUser")
  recordedIncidents       DisciplineIncident[]       @relation("RecordedByUser")
  submittedAppeals        DisciplineAppeal[]         @relation("SubmittedByUser")
  reviewedAppeals         DisciplineAppeal[]         @relation("ReviewedByUser")
  bookLoans               BookLoan[]
  gradedSubmissions       HomeworkSubmission[]       @relation("GradedByUser")
  createdConversations    Conversation[]
  conversationMemberships ConversationParticipant[]
  sentMessages            Message[]
  messageReads            MessageRead[]
  notifications           Notification[]
  pushTokens              PushToken[]
  supportTickets          SupportTicket[]
  clinicVisitsSeen        ClinicVisit[]              @relation("ClinicSeenBy")
  medicationsGiven        MedicationAdministration[] @relation("MedicationGivenBy")
  healthRecordsUpdated    StudentHealthRecord[]      @relation("HealthRecordUpdatedBy")
  meritsAwarded           MeritAward[]               @relation("MeritAwardedBy")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  token      String   @unique
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("user_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── ACADEMIC ───────────────────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")

  terms                 Term[]
  teacherSubjectClasses TeacherSubjectClass[]
  yearResults           YearResult[]

  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  academicYearId String   @map("academic_year_id")
  name           String
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  isCurrent      Boolean  @default(false) @map("is_current")
  isClosed       Boolean  @default(false) @map("is_closed")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  marks               Mark[]
  termResults         TermResult[]
  disciplineIncidents DisciplineIncident[]
  homeworks           Homework[]
  examSchedules       ExamSchedule[]
  activities          Activity[]
  merits              MeritAward[]

  @@unique([academicYearId, name])
  @@index([isCurrent])
  @@map("terms")
}

model ClassLevel {
  id    String         @id @default(uuid())
  name  String         @unique
  order Int
  stage EducationStage @default(O_LEVEL)

  sections            ClassSection[]
  subjects            Subject[]
  activityClassLevels ActivityClassLevel[]

  @@map("class_levels")
}

// A-Level (TVET) trade section, e.g. SWD — Software Development, under the
// national sector it belongs to (e.g. ICT and Multimedia). O-Level has none.
model Trade {
  id     String @id @default(uuid())
  code   String @unique
  name   String @unique
  sector String

  sections ClassSection[]
  subjects Subject[]

  @@map("trades")
}

model ClassSection {
  id           String  @id @default(uuid())
  classLevelId String  @map("class_level_id")
  tradeId      String? @map("trade_id")
  name         String

  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  trade      Trade?     @relation(fields: [tradeId], references: [id], onDelete: Restrict)

  students              Student[]
  timetables            Timetable[]
  teacherSubjectClasses TeacherSubjectClass[]
  marks                 Mark[]
  termResults           TermResult[]
  yearResults           YearResult[]
  attendances           Attendance[]
  homeworks             Homework[]
  examSchedules         ExamSchedule[]
  activitySections      ActivitySection[]

  // Postgres treats NULLs as distinct, so duplicate O-Level names (tradeId
  // null) are additionally guarded in AcademicService.
  @@unique([classLevelId, tradeId, name])
  @@index([tradeId])
  @@map("class_sections")
}

model Subject {
  id           String       @id @default(uuid())
  name         String
  category     String?
  scope        SubjectScope @default(O_CORE)
  tradeId      String?      @map("trade_id")
  classLevelId String?      @map("class_level_id")
  maxMarks     Int          @default(100) @map("max_marks")
  isActive     Boolean      @default(true) @map("is_active")

  trade      Trade?      @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  classLevel ClassLevel? @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  timetables            Timetable[]
  teacherSubjectClasses TeacherSubjectClass[]
  marks                 Mark[]
  attendances           Attendance[]
  homeworks             Homework[]
  examSchedules         ExamSchedule[]

  // Same module name may exist in two trades (e.g. Database Development in
  // both SWD and NIT). General subjects (tradeId null) are service-guarded.
  @@unique([name, tradeId])
  @@index([tradeId])
  @@index([classLevelId])
  @@map("subjects")
}

model AssessmentType {
  id   String @id @default(uuid())
  name String @unique

  marks Mark[]

  @@map("assessment_types")
}

model Timetable {
  id             String  @id @default(uuid())
  classSectionId String  @map("class_section_id")
  subjectId      String  @map("subject_id")
  teacherId      String  @map("teacher_id")
  dayOfWeek      Int     @map("day_of_week") // 1=Monday, 7=Sunday
  startTime      String  @map("start_time")
  endTime        String  @map("end_time")
  room           String?

  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classSectionId])
  @@index([teacherId])
  @@index([dayOfWeek])
  @@map("timetables")
}

// ─── STUDENTS ───────────────────────────────────────────────────────────────────

model Student {
  id                String        @id @default(uuid())
  userId            String        @unique @map("user_id")
  studentIdNumber   String        @unique @map("student_id_number")
  classSectionId    String        @map("class_section_id")
  dateOfBirth       DateTime?     @map("date_of_birth")
  gender            Gender?
  bloodType         String?       @map("blood_type")
  allergies         String?
  medicalConditions String?       @map("medical_conditions")
  previousSchool    String?       @map("previous_school")
  // Residence, the standard 5-level Rwandan address (SDMS requirement).
  province          String?
  district          String?
  sector            String?
  cell              String?
  village           String?
  // SDMS special-needs record; null means none declared.
  disability        String?
  // Guardians as recorded on enrollment, independent of parent accounts.
  fatherName        String?       @map("father_name")
  motherName        String?       @map("mother_name")
  // Mutuelle de Sante or other insurance number.
  insuranceNumber   String?       @map("insurance_number")
  isBoarder         Boolean       @default(false) @map("is_boarder")
  religion          String?
  enrollmentDate    DateTime      @default(now()) @map("enrollment_date")
  nfcCardId         String?       @unique @map("nfc_card_id")
  cardIssuedAt      DateTime?     @map("card_issued_at")
  // Printed on the card as a QR. Unguessable, and cleared when a card is
  // revoked, so a lost card stops verifying the moment it is reissued.
  cardCode          String?       @unique @map("card_code")
  // A card mislaid for a few days is suspended, not revoked: verification
  // refuses it and the gate turns it away, but the same printed card comes
  // back to life when it is found. Revoking destroys the code instead.
  cardSuspendedAt   DateTime?     @map("card_suspended_at")
  status            StudentStatus @default(ACTIVE)
  disciplinePoints  Int           @default(100) @map("discipline_points")
  createdAt         DateTime      @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id])

  pocketMoney         PocketMoneyAccount?
  activities          ActivityParticipant[]
  parentStudents      ParentStudent[]
  marks               Mark[]
  termResults         TermResult[]
  yearResults         YearResult[]
  attendances         Attendance[]
  disciplineIncidents DisciplineIncident[]
  homeworkSubmissions HomeworkSubmission[]
  merits              MeritAward[]
  clinicVisits        ClinicVisit[]
  medications         MedicationAdministration[]
  healthRecord        StudentHealthRecord?

  @@index([classSectionId])
  @@index([status])
  @@map("students")
}

model ParentStudent {
  id           String @id @default(uuid())
  parentUserId String @map("parent_user_id")
  studentId    String @map("student_id")
  relationship String

  parent  User    @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
  @@index([parentUserId])
  @@index([studentId])
  @@map("parent_students")
}

// ─── TEACHERS ───────────────────────────────────────────────────────────────────

model Teacher {
  id               String                @id @default(uuid())
  userId           String                @unique @map("user_id")
  employmentStatus EmploymentStatus      @default(FULL_TIME) @map("employment_status")
  qualification    TeacherQualification?
  rssbNumber       String?               @map("rssb_number")
  hireDate         DateTime?             @map("hire_date")
  isActive         Boolean               @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles                 TeacherRole[]
  teacherSubjectClasses TeacherSubjectClass[]
  timetables            Timetable[]
  marks                 Mark[]
  teacherAttendances    TeacherAttendance[]
  homeworks             Homework[]

  @@map("teachers")
}

model TeacherRole {
  id             String      @id @default(uuid())
  teacherId      String      @map("teacher_id")
  role           SpecialRole
  classSectionId String?     @map("class_section_id")
  department     String?

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, role, classSectionId])
  @@index([teacherId])
  @@map("teacher_roles")
}

model TeacherSubjectClass {
  id             String @id @default(uuid())
  teacherId      String @map("teacher_id")
  subjectId      String @map("subject_id")
  classSectionId String @map("class_section_id")
  academicYearId String @map("academic_year_id")

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classSectionId, academicYearId])
  @@index([teacherId])
  @@index([classSectionId])
  @@map("teacher_subject_classes")
}

// ─── MARKS ──────────────────────────────────────────────────────────────────────

model Mark {
  id               String   @id @default(uuid())
  studentId        String   @map("student_id")
  subjectId        String   @map("subject_id")
  classSectionId   String   @map("class_section_id")
  termId           String   @map("term_id")
  assessmentTypeId String   @map("assessment_type_id")
  score            Float
  maxScore         Float    @default(100) @map("max_score")
  teacherId        String   @map("teacher_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSection   ClassSection   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  term           Term           @relation(fields: [termId], references: [id], onDelete: Cascade)
  assessmentType AssessmentType @relation(fields: [assessmentTypeId], references: [id], onDelete: Cascade)
  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, termId, assessmentTypeId])
  @@index([studentId])
  @@index([subjectId])
  @@index([classSectionId, termId])
  @@index([teacherId])
  @@map("marks")
}

model TermResult {
  id                String  @id @default(uuid())
  studentId         String  @map("student_id")
  classSectionId    String  @map("class_section_id")
  termId            String  @map("term_id")
  totalMarks        Float?  @map("total_marks")
  average           Float?
  letterGrade       String? @map("letter_grade")
  aggregate         Int?
  aggregateMax      Int?    @map("aggregate_max")
  rank              Int?
  teacherComment    String? @map("teacher_comment")
  headmasterComment String? @map("headmaster_comment")
  isPublished       Boolean @default(false) @map("is_published")

  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSection ClassSection        @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  term         Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  verification ReportVerification?

  @@unique([studentId, classSectionId, termId])
  @@index([classSectionId, termId])
  @@map("term_results")
}

// One permanent 12-digit code per issued report card. The code is printed on
// the paper copy (QR + link) and resolves to the digital original.
model ReportVerification {
  id           String   @id @default(uuid())
  code         String   @unique
  termResultId String   @unique @map("term_result_id")
  createdAt    DateTime @default(now()) @map("created_at")

  termResult TermResult @relation(fields: [termResultId], references: [id], onDelete: Cascade)

  @@map("report_verifications")
}

model YearResult {
  id                String  @id @default(uuid())
  studentId         String  @map("student_id")
  classSectionId    String  @map("class_section_id")
  academicYearId    String  @map("academic_year_id")
  term1Avg          Float?  @map("term1_avg")
  term2Avg          Float?  @map("term2_avg")
  term3Avg          Float?  @map("term3_avg")
  yearlyAverage     Float?  @map("yearly_average")
  letterGrade       String? @map("letter_grade")
  rank              Int?
  disciplineAverage Float?  @map("discipline_average")
  isPromoted        Boolean @default(false) @map("is_promoted")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, classSectionId, academicYearId])
  @@index([classSectionId, academicYearId])
  @@map("year_results")
}

// ─── ATTENDANCE ─────────────────────────────────────────────────────────────────

model Attendance {
  id             String           @id @default(uuid())
  studentId      String           @map("student_id")
  classSectionId String           @map("class_section_id")
  date           DateTime         @db.Date
  type           String // "daily" or "subject"
  subjectId      String?          @map("subject_id")
  status         AttendanceStatus
  reasonCategory AbsenceReason?   @map("reason_category")
  scannedAt      DateTime?        @map("scanned_at")
  markedByUserId String           @map("marked_by_user_id")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  markedBy     User         @relation("MarkedByUser", fields: [markedByUserId], references: [id])

  @@unique([studentId, date, type, subjectId])
  @@index([classSectionId, date])
  @@index([studentId, date])
  @@map("attendances")
}

model TeacherAttendance {
  id        String           @id @default(uuid())
  teacherId String           @map("teacher_id")
  date      DateTime         @db.Date
  status    AttendanceStatus
  scannedAt DateTime?        @map("scanned_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([date])
  @@map("teacher_attendances")
}

// ─── DISCIPLINE ─────────────────────────────────────────────────────────────────

model DisciplineIncident {
  id                   String           @id @default(uuid())
  studentId            String           @map("student_id")
  termId               String           @map("term_id")
  recordedByUserId     String           @map("recorded_by_user_id")
  date                 DateTime         @db.Date
  time                 String?
  location             String?
  description          String
  pointsDeducted       Int              @map("points_deducted")
  actionTaken          DisciplineAction @map("action_taken")
  parentAcknowledged   Boolean          @default(false) @map("parent_acknowledged")
  parentAcknowledgedAt DateTime?        @map("parent_acknowledged_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term       Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("RecordedByUser", fields: [recordedByUserId], references: [id])

  appeals DisciplineAppeal[]

  @@index([studentId])
  @@index([termId])
  @@map("discipline_incidents")
}

model DisciplineAppeal {
  id                String       @id @default(uuid())
  incidentId        String       @map("incident_id")
  submittedByUserId String       @map("submitted_by_user_id")
  statement         String
  evidenceUrls      String[]     @map("evidence_urls")
  status            AppealStatus @default(PENDING)
  reviewedByUserId  String?      @map("reviewed_by_user_id")
  reviewNotes       String?      @map("review_notes")
  createdAt         DateTime     @default(now()) @map("created_at")

  incident    DisciplineIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  submittedBy User               @relation("SubmittedByUser", fields: [submittedByUserId], references: [id])
  reviewedBy  User?              @relation("ReviewedByUser", fields: [reviewedByUserId], references: [id])

  @@index([incidentId])
  @@map("discipline_appeals")
}

// ─── LIBRARY ────────────────────────────────────────────────────────────────────

model Book {
  id              String  @id @default(uuid())
  title           String
  author          String
  isbn            String? @unique
  category        String?
  quantity        Int     @default(1)
  availableCount  Int     @default(1) @map("available_count")
  barcode         String? @unique
  shelfLocation   String? @map("shelf_location")
  replacementCost Float?  @map("replacement_cost")
  isActive        Boolean @default(true) @map("is_active")

  loans BookLoan[]

  @@index([title])
  @@index([category])
  @@map("books")
}

model BookLoan {
  id              String     @id @default(uuid())
  bookId          String     @map("book_id")
  borrowerUserId  String     @map("borrower_user_id")
  checkedOutAt    DateTime   @default(now()) @map("checked_out_at")
  dueDate         DateTime   @map("due_date")
  returnedAt      DateTime?  @map("returned_at")
  status          LoanStatus @default(ACTIVE)
  replacementCost Float?     @map("replacement_cost")

  book     Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  borrower User @relation(fields: [borrowerUserId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([borrowerUserId])
  @@index([status])
  @@map("book_loans")
}

// ─── HOMEWORK ───────────────────────────────────────────────────────────────────

/// What a teacher sets for a class: homework, an assignment, a quiz, a test or
/// a project. One model, because they differ only in what they are called and
/// how much they are worth, and a school that keeps them apart ends up unable
/// to answer "how much work has Senior 1 been set this week".
enum AssessmentKind {
  HOMEWORK
  ASSIGNMENT
  QUIZ
  TEST
  PROJECT
  PRACTICAL
}

model Homework {
  id                  String         @id @default(uuid())
  teacherId           String         @map("teacher_id")
  subjectId           String         @map("subject_id")
  classSectionId      String         @map("class_section_id")
  termId              String         @map("term_id")
  kind                AssessmentKind @default(HOMEWORK)
  title               String
  description         String?
  dueDate             DateTime       @map("due_date")
  maxMarks            Float?         @map("max_marks")
  lateDeductionPerDay Float?         @default(0) @map("late_deduction_per_day")
  createdAt           DateTime       @default(now()) @map("created_at")

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])

  submissions HomeworkSubmission[]

  @@index([classSectionId, termId])
  @@index([teacherId])
  @@map("homeworks")
}

model HomeworkSubmission {
  id             String    @id @default(uuid())
  homeworkId     String    @map("homework_id")
  studentId      String    @map("student_id")
  fileUrl        String?   @map("file_url")
  submittedAt    DateTime  @default(now()) @map("submitted_at")
  isLate         Boolean   @default(false) @map("is_late")
  marks          Float?
  gradedAt       DateTime? @map("graded_at")
  gradedByUserId String?   @map("graded_by_user_id")

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy User?    @relation("GradedByUser", fields: [gradedByUserId], references: [id])

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
  @@map("homework_submissions")
}

// ─── MESSAGING ──────────────────────────────────────────────────────────────────

model Conversation {
  id              String           @id @default(uuid())
  type            ConversationType
  name            String?
  createdByUserId String           @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  createdBy    User                      @relation(fields: [createdByUserId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")
  isAdmin        Boolean  @default(false) @map("is_admin")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String             @id @default(uuid())
  conversationId String             @map("conversation_id")
  senderUserId   String             @map("sender_user_id")
  content        String
  contentType    MessageContentType @default(TEXT) @map("content_type")
  status         MessageStatus      @default(SENT)
  fileUrl        String?            @map("file_url")
  /// The name the sender's file had, kept apart from the uuid it is stored
  /// under. A recipient offered "a1b2c3.pdf" does not know what it is.
  fileName       String?            @map("file_name")
  createdAt      DateTime           @default(now()) @map("created_at")

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderUserId], references: [id])
  reads        MessageRead[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageRead {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_reads")
}

// ─── NOTIFICATIONS ──────────────────────────────────────────────────────────────

model Notification {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  title             String
  message           String
  type              NotificationType
  isRead            Boolean          @default(false) @map("is_read")
  relatedEntityType String?          @map("related_entity_type")
  relatedEntityId   String?          @map("related_entity_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String // 'ios', 'android'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─── SUPPORT ────────────────────────────────────────────────────────────────────

model SupportTicket {
