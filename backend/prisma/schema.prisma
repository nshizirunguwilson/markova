generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  /**
   * What the running application connects as: markova_app, which can read and
   * write rows and nothing else. It is deliberately not the owner, because a
   * superuser bypasses every row level security policy however the table is
   * configured, and an application that can drop a table has more power than
   * anything in it needs.
   */
  url      = env("DATABASE_URL")

  /**
   * What migrations connect as: the owner, which can alter the schema.
   * Two URLs because the two jobs need different power. `prisma migrate` and
   * `prisma db seed` use this; nothing at runtime does. It falls back to
   * DATABASE_URL so a developer who has not set it still gets a working
   * `migrate dev`, which is the common case on a fresh clone.
   */
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  LIBRARIAN
  /// Boys' boarding master. Runs the dormitories, holds pocket money, and
  /// takes students to the clinic. A real role in a Rwandan boarding school,
  /// not an administrator with extra duties.
  PATRON
  /// Girls' boarding mistress. The same duties, for the girls' side.
  MATRON
  /// Keeps the fee ledger: raises the term's invoices, takes payments at the
  /// counter, and decides who is carried. Sees the money and the roll, and
  /// nothing academic - a bursar has no business in a mark book.
  BURSAR
  /// School nurse. Sees health records; sees nothing academic.
  NURSE
  /// Head teacher, the Director of Studies in a Rwandan school. Runs the
  /// academic side: confirms every report card before the principal issues
  /// it, writes the head teacher's comment on each one, and manages the
  /// teaching staff's timetable and attendance. Distinct from SpecialRole.DOS,
  /// which marks a teacher who also holds the duty; this is somebody whose
  /// whole post it is.
  HEAD_TEACHER
}

enum SpecialRole {
  DOS
  HOD
  CLASS_TEACHER
}

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  CONTRACT
}

// Rwandan teaching credential levels: A0 bachelor's, A1 diploma, A2 secondary.
enum TeacherQualification {
  A0
  A1
  A2
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
}

enum Gender {
  MALE
  FEMALE
}

enum EducationStage {
  O_LEVEL
  A_LEVEL
}

enum SubjectScope {
  O_CORE
  O_ELECTIVE
  A_GENERAL
  A_SPECIFIC
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AbsenceReason {
  SICK
  FAMILY
  PERMISSION
  UNEXCUSED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
  DAMAGED
}

enum DisciplineAction {
  VERBAL_WARNING
  WRITTEN_WARNING
  DETENTION
  SUSPENSION
  EXPULSION
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationType {
  ONE_ON_ONE
  GROUP
  BROADCAST
}

enum MessageContentType {
  TEXT
  FILE
  VOICE
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

/// How a notice reached somebody, which is not the same as what it was about.
///
/// `IN_APP` is the bell in the dashboard: written down, shown when they next
/// look, and never sent anywhere. It was missing, so anything meant only for
/// the bell was recorded as EMAIL or PUSH and looked, in the record, like a
/// message that had been sent and might have failed to arrive.
enum NotificationType {
  SMS
  EMAIL
  PUSH
  IN_APP
}

// ─── CORE ───────────────────────────────────────────────────────────────────────

/// A school using Markova. Every record a school owns carries its id, and the
/// database refuses to show one school's rows to another (see
/// docs/MULTI-SCHOOL-DESIGN.md).
model School {
  id        String       @id @default(uuid())
  name      String
  /// Short, readable and unique: used in addresses and codes.
  slug      String       @unique
  status    SchoolStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  schoolConfigs             SchoolConfig[]
  users                     User[]
  auditLogs                 AuditLog[]
  academicYears             AcademicYear[]
  terms                     Term[]
  classLevels               ClassLevel[]
  trades                    Trade[]
  classSections             ClassSection[]
  subjects                  Subject[]
  assessmentTypes           AssessmentType[]
  timetables                Timetable[]
  students                  Student[]
  parentStudents            ParentStudent[]
  teachers                  Teacher[]
  teacherRoles              TeacherRole[]
  teacherSubjectClasses     TeacherSubjectClass[]
  marks                     Mark[]
  termResults               TermResult[]
  reportVerifications       ReportVerification[]
  yearResults               YearResult[]
  attendances               Attendance[]
  teacherAttendances        TeacherAttendance[]
  disciplineIncidents       DisciplineIncident[]
  disciplineAppeals         DisciplineAppeal[]
  books                     Book[]
  bookLoans                 BookLoan[]
  homeworks                 Homework[]
  homeworkSubmissions       HomeworkSubmission[]
  conversations             Conversation[]
  conversationParticipants  ConversationParticipant[]
  messages                  Message[]
  messageMentions           MessageMention[]
  messageReads              MessageRead[]
  notifications             Notification[]
  supportTickets            SupportTicket[]
  examSchedules             ExamSchedule[]
  faqArticles               FaqArticle[]
  pocketMoneyAccounts       PocketMoneyAccount[]
  pocketMoneyTransactions   PocketMoneyTransaction[]
  activities                Activity[]
  activityClassLevels       ActivityClassLevel[]
  activitySections          ActivitySection[]
  activityParticipants      ActivityParticipant[]
  clinicVisits              ClinicVisit[]
  medicationAdministrations MedicationAdministration[]
  studentHealthRecords      StudentHealthRecord[]
  meritAwards               MeritAward[]
  feeItems                  FeeItem[]
  feeInvoices               FeeInvoice[]
  feeInvoiceLines           FeeInvoiceLine[]
  feePayments               FeePayment[]
  feeWaivers                FeeWaiver[]
  admissionIntakes          AdmissionIntake[]
  applications              Application[]
  applicationDocuments      ApplicationDocument[]
  applicationEvents         ApplicationEvent[]
  applicationNotes          ApplicationNote[]
  admissionOffers           AdmissionOffer[]

  @@map("schools")
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// A power above every school, held by a login rather than a school record.
enum PlatformRole {
  /// Runs Markova itself: adds, suspends and removes schools, and reads
  /// numbers about them. Inside a school the owner is only whatever their
  /// school record there says, like anybody else.
  OWNER
}

/// How one person signs in, once, for every school they belong to.
///
/// What a school knows about the person (their name, photo, role and work)
/// lives on their User record in that school. This holds only the sign in:
/// the phone or email, the password, and which school to open first. A
/// person who is a teacher at one school and a parent at another has one
/// Account and two Users. See docs/MULTI-SCHOOL-DESIGN.md.
model Account {
  id                  String        @id @default(uuid())
  /// Sign in by email. Changed only by the person, after a code.
  email               String?       @unique
  /// Sign in by phone. Changed only by the person, after a code.
  phone               String?       @unique
  passwordHash        String?       @map("password_hash")
  forcePasswordChange Boolean       @default(true) @map("force_password_change")
  platformRole        PlatformRole? @map("platform_role")
  lastLoginAt         DateTime?     @map("last_login_at")
  /// The school record opened last, which the next sign in opens first.
  lastUserId          String?       @map("last_user_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  users      User[]
  sessions   UserSession[]
  pushTokens PushToken[]

  @@map("accounts")
}

model SchoolConfig {
  id       String @id @default(uuid())
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  key      String
  value    String

  @@unique([schoolId, key])
  @@map("school_configs")
}

model User {
  id           String    @id @default(uuid())
  schoolId     String    @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// The login this school record belongs to. One person, one Account; one
  /// User in each school they belong to.
  accountId    String    @map("account_id")
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// How this school reaches the person. Starts as their sign in email and
  /// phone, and the school may change it: it is the school's own contact
  /// record, not how the person signs in (that is on Account).
  email        String?
  phone        String?
  // Role-based registration code for staff and parents (TCH/PAR/LIB/ADM).
  // Students carry theirs on Student.studentIdNumber (STD prefix).
  code         String?
  // NIDA 16-digit national identification number (stored without spaces).
  nationalId   String?   @map("national_id")
  nationality  String?
  // For staff and parents. Students carry theirs on Student, which stays
  // the single source of truth for student demographics.
  gender       Gender?
  dateOfBirth  DateTime? @map("date_of_birth")
  role         Role
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  photoUrl     String?   @map("photo_url")
  /// The person's own signature, uploaded from their own profile, printed
  /// where a document needs their name under a line. Deliberately not the
  /// school's signature from the branding settings: a report card carries a
  /// class teacher's and a head teacher's marks, and one file shared between
  /// them would put the same hand under both.
  signatureUrl String?   @map("signature_url")
  isActive     Boolean   @default(true) @map("is_active")
  /// When the person last opened this school: per school, so one school
  /// never learns when somebody used another.
  lastLoginAt  DateTime? @map("last_login_at")
  lastSeenAt   DateTime? @map("last_seen_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  sessions                UserSession[]
  auditLogs               AuditLog[]
  pocketMoneyEntries      PocketMoneyTransaction[]   @relation("PocketMoneyRecordedBy")
  activitiesCreated       Activity[]                 @relation("ActivityCreatedBy")
  reportCardsConfirmed    TermResult[]               @relation("ReportCardsConfirmed")
  messageMentions         MessageMention[]
  activityConsents        ActivityParticipant[]      @relation("ActivityConsentBy")
  student                 Student?
  teacher                 Teacher?
  parentStudents          ParentStudent[]
  markedAttendances       Attendance[]               @relation("MarkedByUser")
  recordedIncidents       DisciplineIncident[]       @relation("RecordedByUser")
  submittedAppeals        DisciplineAppeal[]         @relation("SubmittedByUser")
  reviewedAppeals         DisciplineAppeal[]         @relation("ReviewedByUser")
  bookLoans               BookLoan[]
  gradedSubmissions       HomeworkSubmission[]       @relation("GradedByUser")
  createdConversations    Conversation[]
  conversationMemberships ConversationParticipant[]
  sentMessages            Message[]
  messageReads            MessageRead[]
  notifications           Notification[]
  supportTickets          SupportTicket[]
  clinicVisitsSeen        ClinicVisit[]              @relation("ClinicSeenBy")
  medicationsGiven        MedicationAdministration[] @relation("MedicationGivenBy")
  healthRecordsUpdated    StudentHealthRecord[]      @relation("HealthRecordUpdatedBy")
  meritsAwarded           MeritAward[]               @relation("MeritAwardedBy")
  feePaymentsRecorded     FeePayment[]               @relation("FeePaymentRecordedBy")
  feePaymentsVoided       FeePayment[]               @relation("FeePaymentVoidedBy")
  feeWaiversGranted       FeeWaiver[]                @relation("FeeWaiverGrantedBy")
  feeWaiversRevoked       FeeWaiver[]                @relation("FeeWaiverRevokedBy")
  applicationDocsVerified ApplicationDocument[]      @relation("ApplicationDocVerifiedBy")
  applicationEvents       ApplicationEvent[]         @relation("ApplicationEventActor")
  applicationNotes        ApplicationNote[]          @relation("ApplicationNoteAuthor")
  admissionOffers         AdmissionOffer[]           @relation("AdmissionOfferedBy")

  @@unique([schoolId, code])
  @@unique([schoolId, nationalId])
  /// A person holds a role in a school once. A teacher who is also a parent
  /// at the same school has two records, one for each role.
  @@unique([schoolId, accountId, role])
  @@index([accountId])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

/// A device signed in to an Account. It is open on one of the account's
/// school records at a time (`userId`), and switching school moves it.
model UserSession {
  id         String   @id @default(uuid())
  accountId  String   @map("account_id")
  userId     String   @map("user_id")
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  token      String   @unique
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([userId])
  @@index([token])
  @@map("user_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?  @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([schoolId])
  @@map("audit_logs")
}

// ─── ACADEMIC ───────────────────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name      String
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")

  terms                 Term[]
  teacherSubjectClasses TeacherSubjectClass[]
  yearResults           YearResult[]
  admissionIntakes      AdmissionIntake[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  schoolId       String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String   @map("academic_year_id")
  name           String
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  isCurrent      Boolean  @default(false) @map("is_current")
  isClosed       Boolean  @default(false) @map("is_closed")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  marks               Mark[]
  termResults         TermResult[]
  disciplineIncidents DisciplineIncident[]
  homeworks           Homework[]
  examSchedules       ExamSchedule[]
  activities          Activity[]
  merits              MeritAward[]
  feeItems            FeeItem[]
  feeInvoices         FeeInvoice[]

  @@unique([academicYearId, name])
  @@index([isCurrent])
  @@index([schoolId])
  @@map("terms")
}

model ClassLevel {
  id       String         @id @default(uuid())
  schoolId String         @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school   School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name     String
  order    Int
  stage    EducationStage @default(O_LEVEL)

  sections            ClassSection[]
  subjects            Subject[]
  activityClassLevels ActivityClassLevel[]
  feeItems            FeeItem[]
  admissionIntakes    AdmissionIntake[]

  @@unique([schoolId, name])
  @@map("class_levels")
}

// A-Level (TVET) trade section, e.g. SWD - Software Development, under the
// national sector it belongs to (e.g. ICT and Multimedia). O-Level has none.
model Trade {
  id       String @id @default(uuid())
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  code     String
  name     String
  sector   String

  sections ClassSection[]
  subjects Subject[]

  applications             Application[] @relation("ApplicationTrade")
  secondChoiceApplications Application[] @relation("ApplicationSecondChoice")

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@map("trades")
}

model ClassSection {
  id           String  @id @default(uuid())
  schoolId     String  @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classLevelId String  @map("class_level_id")
  tradeId      String? @map("trade_id")
  name         String

  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  trade      Trade?     @relation(fields: [tradeId], references: [id], onDelete: Restrict)

  students              Student[]
  timetables            Timetable[]
  teacherSubjectClasses TeacherSubjectClass[]
  marks                 Mark[]
  termResults           TermResult[]
  yearResults           YearResult[]
  attendances           Attendance[]
  homeworks             Homework[]
  examSchedules         ExamSchedule[]
  activitySections      ActivitySection[]
  admissionOffers       AdmissionOffer[]

  /// The class's own group chat. One per class, created with the class.
  groupChat Conversation?

  // Postgres treats NULLs as distinct, so duplicate O-Level names (tradeId
  // null) are additionally guarded in AcademicService.
  @@unique([classLevelId, tradeId, name])
  @@index([tradeId])
  @@index([schoolId])
  @@map("class_sections")
}

model Subject {
  id           String       @id @default(uuid())
  schoolId     String       @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name         String
  category     String?
  scope        SubjectScope @default(O_CORE)
  tradeId      String?      @map("trade_id")
  classLevelId String?      @map("class_level_id")
  maxMarks     Int          @default(100) @map("max_marks")
  isActive     Boolean      @default(true) @map("is_active")

  trade      Trade?      @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  classLevel ClassLevel? @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  timetables            Timetable[]
  teacherSubjectClasses TeacherSubjectClass[]
  marks                 Mark[]
  attendances           Attendance[]
  homeworks             Homework[]
  examSchedules         ExamSchedule[]

  // Same module name may exist in two trades (e.g. Database Development in
  // both SWD and NIT). General subjects (tradeId null) are service-guarded.
  @@unique([schoolId, name, tradeId])
  @@index([tradeId])
  @@index([classLevelId])
  @@map("subjects")
}

model AssessmentType {
  id       String @id @default(uuid())
  schoolId String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  name     String

  marks Mark[]

  @@unique([schoolId, name])
  @@map("assessment_types")
}

model Timetable {
  id             String  @id @default(uuid())
  schoolId       String  @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school         School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  classSectionId String  @map("class_section_id")
  subjectId      String  @map("subject_id")
  teacherId      String  @map("teacher_id")
  dayOfWeek      Int     @map("day_of_week") // 1=Monday, 7=Sunday
  startTime      String  @map("start_time")
  endTime        String  @map("end_time")
  room           String?

  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classSectionId])
  @@index([teacherId])
  @@index([dayOfWeek])
  @@index([schoolId])
  @@map("timetables")
}

// ─── STUDENTS ───────────────────────────────────────────────────────────────────

model Student {
  id                String        @id @default(uuid())
  schoolId          String        @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userId            String        @unique @map("user_id")
  studentIdNumber   String        @map("student_id_number")
  classSectionId    String        @map("class_section_id")
  dateOfBirth       DateTime?     @map("date_of_birth")
  gender            Gender?
  bloodType         String?       @map("blood_type")
  allergies         String?
  medicalConditions String?       @map("medical_conditions")
  previousSchool    String?       @map("previous_school")
  // Residence, the standard 5-level Rwandan address (SDMS requirement).
  province          String?
  district          String?
  sector            String?
  cell              String?
  village           String?
  // SDMS special-needs record; null means none declared.
  disability        String?
  // Guardians as recorded on enrollment, independent of parent accounts.
  fatherName        String?       @map("father_name")
  motherName        String?       @map("mother_name")
  // Mutuelle de Sante or other insurance number.
  insuranceNumber   String?       @map("insurance_number")
  isBoarder         Boolean       @default(false) @map("is_boarder")
  religion          String?
  enrollmentDate    DateTime      @default(now()) @map("enrollment_date")
  nfcCardId         String?       @map("nfc_card_id")
  cardIssuedAt      DateTime?     @map("card_issued_at")
  // Printed on the card as a QR. Unguessable, and cleared when a card is
  // revoked, so a lost card stops verifying the moment it is reissued.
  cardCode          String?       @unique @map("card_code")
  // A card mislaid for a few days is suspended, not revoked: verification
  // refuses it and the gate turns it away, but the same printed card comes
  // back to life when it is found. Revoking destroys the code instead.
  cardSuspendedAt   DateTime?     @map("card_suspended_at")
  status            StudentStatus @default(ACTIVE)
  disciplinePoints  Int           @default(100) @map("discipline_points")
  createdAt         DateTime      @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id])

  pocketMoney         PocketMoneyAccount?
  activities          ActivityParticipant[]
  parentStudents      ParentStudent[]
  marks               Mark[]
  termResults         TermResult[]
  yearResults         YearResult[]
  attendances         Attendance[]
  disciplineIncidents DisciplineIncident[]
  homeworkSubmissions HomeworkSubmission[]
  merits              MeritAward[]
  clinicVisits        ClinicVisit[]
  medications         MedicationAdministration[]
  healthRecord        StudentHealthRecord?
  feeInvoices         FeeInvoice[]
  application         Application?

  @@unique([schoolId, studentIdNumber])
  @@unique([schoolId, nfcCardId])
  @@index([classSectionId])
  @@index([status])
  @@map("students")
}

model ParentStudent {
  id           String @id @default(uuid())
  schoolId     String @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school       School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  parentUserId String @map("parent_user_id")
  studentId    String @map("student_id")
  relationship String

  parent  User    @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
  @@index([parentUserId])
  @@index([studentId])
  @@index([schoolId])
  @@map("parent_students")
}

// ─── TEACHERS ───────────────────────────────────────────────────────────────────

model Teacher {
  id               String                @id @default(uuid())
  schoolId         String                @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userId           String                @unique @map("user_id")
  employmentStatus EmploymentStatus      @default(FULL_TIME) @map("employment_status")
  qualification    TeacherQualification?
  rssbNumber       String?               @map("rssb_number")
  hireDate         DateTime?             @map("hire_date")
  isActive         Boolean               @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles                 TeacherRole[]
  teacherSubjectClasses TeacherSubjectClass[]
  timetables            Timetable[]
  marks                 Mark[]
  teacherAttendances    TeacherAttendance[]
