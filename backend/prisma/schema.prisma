// ─── HOMEWORK ───────────────────────────────────────────────────────────────────

/// What a teacher sets for a class: homework, an assignment, a quiz, a test or
/// a project. One model, because they differ only in what they are called and
/// how much they are worth, and a school that keeps them apart ends up unable
/// to answer "how much work has Senior 1 been set this week".
enum AssessmentKind {
  HOMEWORK
  ASSIGNMENT
  QUIZ
  TEST
  PROJECT
  PRACTICAL
}

model Homework {
  id                  String         @id @default(uuid())
  schoolId            String         @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  teacherId           String         @map("teacher_id")
  subjectId           String         @map("subject_id")
  classSectionId      String         @map("class_section_id")
  termId              String         @map("term_id")
  kind                AssessmentKind @default(HOMEWORK)
  title               String
  description         String?
  dueDate             DateTime       @map("due_date")
  maxMarks            Float?         @map("max_marks")
  lateDeductionPerDay Float?         @default(0) @map("late_deduction_per_day")
  createdAt           DateTime       @default(now()) @map("created_at")

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id])
  term         Term         @relation(fields: [termId], references: [id])

  submissions HomeworkSubmission[]

  @@index([classSectionId, termId])
  @@index([teacherId])
  @@index([schoolId])
  @@map("homeworks")
}

model HomeworkSubmission {
  id             String    @id @default(uuid())
  schoolId       String    @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  homeworkId     String    @map("homework_id")
  studentId      String    @map("student_id")
  fileUrl        String?   @map("file_url")
  submittedAt    DateTime  @default(now()) @map("submitted_at")
  isLate         Boolean   @default(false) @map("is_late")
  marks          Float?
  gradedAt       DateTime? @map("graded_at")
  gradedByUserId String?   @map("graded_by_user_id")

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy User?    @relation("GradedByUser", fields: [gradedByUserId], references: [id])

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
  @@index([schoolId])
  @@map("homework_submissions")
