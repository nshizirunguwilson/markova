model TermResult {
  id                String  @id @default(uuid())
  schoolId          String  @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school            School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId         String  @map("student_id")
  classSectionId    String  @map("class_section_id")
  termId            String  @map("term_id")
  totalMarks        Float?  @map("total_marks")
  average           Float?
  letterGrade       String? @map("letter_grade")
  aggregate         Int?
  aggregateMax      Int?    @map("aggregate_max")
  rank              Int?
  teacherComment    String? @map("teacher_comment")
  headmasterComment String? @map("headmaster_comment")

  /// When the figures above were last worked out from the recorded marks.
  /// Recalculating an unchanged class produces identical numbers, so without
  /// this there is no way to tell that the calculation ran at all.
  calculatedAt DateTime? @map("calculated_at")

  /// Marks released: the student and their parents may see the subject
  /// breakdown, the average and the position.
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  /// The report card issued, which is a separate act. A school routinely
  /// releases marks as soon as they are checked, then issues the formal
  /// document later - after deliberation, and once the head teacher's
  /// comments are written. Marks must be published first: a report card
  /// carries them, so issuing one without them is a contradiction.
  reportCardPublished   Boolean   @default(false) @map("report_card_published")
  reportCardPublishedAt DateTime? @map("report_card_published_at")

  /// Checked and stood behind by the head teacher, which is the step between
  /// the comments being written and the principal issuing the card. A school
  /// that issues without it has nobody who read the sheet before the family
  /// did, so `publishReportCards` refuses until this is set.
  dosConfirmed     Boolean   @default(false) @map("dos_confirmed")
  dosConfirmedAt   DateTime? @map("dos_confirmed_at")
  dosConfirmedById String?   @map("dos_confirmed_by_id")

  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSection   ClassSection        @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  term           Term                @relation(fields: [termId], references: [id], onDelete: Cascade)
  verification   ReportVerification?
  dosConfirmedBy User?               @relation("ReportCardsConfirmed", fields: [dosConfirmedById], references: [id], onDelete: SetNull)

  @@unique([studentId, classSectionId, termId])
  @@index([classSectionId, termId])
  @@index([schoolId])
  @@map("term_results")
}

// One permanent 12-digit code per issued report card. The code is printed on
// the paper copy (QR + link) and resolves to the digital original.
model ReportVerification {
  id           String   @id @default(uuid())
  schoolId     String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
