// ─── MESSAGING ──────────────────────────────────────────────────────────────────

model Conversation {
  id              String           @id @default(uuid())
  schoolId        String           @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  type            ConversationType
  name            String?
  createdByUserId String           @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  /// Set on the one group that belongs to a class, and null on every other
  /// conversation. A class has exactly one of these - it is the room the
  /// class and its teacher are already in, created with the class rather
  /// than by somebody remembering to.
  classSectionId String? @unique @map("class_section_id")

  createdBy    User                      @relation(fields: [createdByUserId], references: [id])
  classSection ClassSection?             @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([schoolId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  schoolId       String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")
  isAdmin        Boolean  @default(false) @map("is_admin")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([schoolId])
  @@map("conversation_participants")
}

model Message {
  id             String             @id @default(uuid())
  schoolId       String             @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  conversationId String             @map("conversation_id")
  senderUserId   String             @map("sender_user_id")
  content        String
  contentType    MessageContentType @default(TEXT) @map("content_type")
  status         MessageStatus      @default(SENT)
  fileUrl        String?            @map("file_url")
  /// The name the sender's file had, kept apart from the uuid it is stored
  /// under. A recipient offered "a1b2c3.pdf" does not know what it is.
  fileName       String?            @map("file_name")
  createdAt      DateTime           @default(now()) @map("created_at")

  /// The message this one answers, when it answers one.
  ///
  /// Set null rather than cascaded when the original goes: a reply is still a
  /// thing somebody said, and deleting it because the message above it was
  /// removed would take a real sentence out of the conversation.
  replyToId String? @map("reply_to_id")

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderUserId], references: [id])
  reads        MessageRead[]
  mentions     MessageMention[]
  replyTo      Message?         @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]        @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([schoolId])
  @@map("messages")
}

/// Who a message names.
///
/// Derived from the `@[Name](id)` markup in the message content, in the same
/// write, so the two can never drift apart. Kept as rows rather than read out
/// of the text because this is what answers "was I mentioned" and what a
/// notification is built from - searching message content with LIKE for an id
/// would be both slow and wrong, matching anybody who quoted one in a
/// sentence.
model MessageMention {
  id          String   @id @default(uuid())
  schoolId    String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  messageId   String   @map("message_id")
  userId      String   @map("user_id")
  /// Set when the message addressed the whole room rather than this person by
  /// name. A reader is owed the difference: being one of thirty is not the
  /// same as being asked.
  viaEveryone Boolean  @default(false) @map("via_everyone")
  createdAt   DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([schoolId])
  @@map("message_mentions")
}

model MessageRead {
  id        String   @id @default(uuid())
  schoolId  String   @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([schoolId])
  @@map("message_reads")
}

// ─── NOTIFICATIONS ──────────────────────────────────────────────────────────────

model Notification {
  id                String           @id @default(uuid())
  schoolId          String           @default(dbgenerated("current_setting('app.school_id'::text)")) @map("school_id")
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  userId            String           @map("user_id")
  title             String
  message           String
  type              NotificationType
  isRead            Boolean          @default(false) @map("is_read")
  relatedEntityType String?          @map("related_entity_type")
  relatedEntityId   String?          @map("related_entity_id")
  createdAt         DateTime         @default(now()) @map("created_at")

  /// How many things this one entry stands for.
  ///
  /// A message that arrives while somebody is elsewhere leaves a notification
  /// behind, so missing the toast no longer means losing it. But one entry per
  /// message would give a person in a busy class group two hundred of them by
  /// lunchtime, and a bell nobody opens is a bell that notifies nobody. So the
  /// unread entry for a conversation is updated instead of duplicated, and
  /// this is what it says: "4 new messages in Senior 1 A".
  ///
  /// A mention is never rolled up this way. Being named is directed at you
  /// personally, and burying it under a count is exactly how it gets missed.
  count Int @default(1)

  /// Last time this entry was added to, which is what it sorts by. An entry
  /// created this morning and added to a minute ago belongs at the top.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  /// What the roll-up looks up: this person's unread entry for this thing.
  @@index([userId, isRead, relatedEntityType, relatedEntityId])
  @@index([schoolId])
  @@map("notifications")
}

/// A phone that receives push notifications for a login: every school the
/// person belongs to, not only the one open when the app registered it.
model PushToken {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  token     String   @unique
  platform  String // 'ios', 'android'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("push_tokens")
}

