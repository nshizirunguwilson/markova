# ─────────────────────────────────────────────────────────────────────────────
# Markova - backend environment
# Copy to backend/.env and fill in. Every variable the backend reads is listed
# here; anything marked REQUIRED has no safe default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API.
# Defaults to the Next.js dashboard (:3001) and Expo web (:8081).
# In production set this to your real dashboard origin, e.g. https://school.example.com
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Public URL of the WEB DASHBOARD. Used to build password-reset links in email.
APP_URL=http://localhost:3001

# Which school the pages before sign in belong to (the sign in screen's name
# and colours, the public admissions form), by its slug. Needed once the
# database holds more than one school; with one, it is found on its own.
# Signed-in pages always use the person's own school.
DEFAULT_SCHOOL=markova-academy

# ── Data stores (REQUIRED) ───────────────────────────────────────────────────
# Ports match docker-compose.yml, which deliberately avoids the defaults.
# What the running API connects as.
#
# markova_app can read and write rows and nothing else. Deliberately not the
# owner: a superuser bypasses every row level security policy however the table
# is configured, so connecting as one would silently undo the isolation that
# keeps one family from reading another's records.
DATABASE_URL=postgresql://markova_app:markova_app@localhost:5434/markova

# What migrations and the seed connect as.
#
# The owner, because they alter the schema and the application role cannot.
# Used by `prisma migrate` and `prisma db seed`; nothing at runtime touches it.
DIRECT_DATABASE_URL=postgresql://markova:password@localhost:5434/markova
REDIS_URL=redis://localhost:6380

# ── Auth secrets (REQUIRED) ──────────────────────────────────────────────────
# Generate each one separately:  openssl rand -base64 48
#
# They must not be equal. Access and refresh tokens carry the same payload, so
# one shared key would let a 7 day refresh token be presented as a 15 minute
# access token. The app refuses to start if they match, if either is missing,
# or if either is still the placeholder below.
JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-base64-48

# ── Deployment ───────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the API. Render, Railway, Fly and a
# single nginx are all 1; nginx behind Cloudflare is 2. Leave unset when the API
# is exposed directly. Rate limiting keys on the client IP, and without this the
# whole site shares one bucket. Setting it higher than the real hop count lets a
# client forge X-Forwarded-For and skip rate limiting entirely.
TRUST_PROXY=

# Swagger at /api/docs. Off in production unless set to true, because it lists
# every route and the roles each one needs.
SWAGGER_ENABLED=

# ── File uploads ─────────────────────────────────────────────────────────────
# Directory served publicly at /uploads. Relative paths resolve from backend/.
UPLOAD_DIR=./uploads

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email; OTP codes are then only returned in
# the login response while NODE_ENV is not "production".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@markova.edu
SMTP_FROM_NAME=Markova School

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Leave TWILIO_SID empty to disable SMS delivery.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SENDER_ID=Markova

# ── Push notifications (Expo) ────────────────────────────────────────────────
# Only needed for the mobile app. An access token is required if the Expo
# project enforces push security; otherwise leave blank.
EXPO_ACCESS_TOKEN=

# ── PDF export ───────────────────────────────────────────────────────────────
# Path to a Chrome/Chromium binary for report-card PDF rendering.
# macOS:  /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:  /usr/bin/chromium
# Docker: set automatically in backend/Dockerfile
CHROME_PATH=

# ── Error tracking (optional) ────────────────────────────────────────────────
# ── The school's own clock ───────────────────────────────────────────────────
#
# Attendance is a date and a marks deadline is a moment, and both are computed
# from a day boundary. A container defaults to UTC, which puts a Rwandan
# school's register two hours out: a class taken at 07:30 lands on the previous
# day, quietly, and nobody notices until a parent queries an absence.
#
# Set to the school's IANA zone. The whole stack reads it, including Postgres.
TZ=Africa/Kigali

SENTRY_DSN=
