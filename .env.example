# ─────────────────────────────────────────────────────────────────────────────
# Markova — backend environment
# Copy to backend/.env and fill in. Every variable the backend reads is listed
# here; anything marked REQUIRED has no safe default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated browser origins allowed to call the API.
# Defaults to the Next.js dashboard (:3001) and Expo web (:8081).
# In production set this to your real dashboard origin, e.g. https://school.example.com
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Public URL of the WEB DASHBOARD. Used to build password-reset links in email.
APP_URL=http://localhost:3001

# ── Data stores (REQUIRED) ───────────────────────────────────────────────────
# Ports match docker-compose.yml, which deliberately avoids the defaults.
DATABASE_URL=postgresql://markova:password@localhost:5434/markova
REDIS_URL=redis://localhost:6380

# ── Auth secrets (REQUIRED — generate with: openssl rand -base64 48) ─────────
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# ── File uploads ─────────────────────────────────────────────────────────────
# Directory served publicly at /uploads. Relative paths resolve from backend/.
UPLOAD_DIR=./uploads

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email; OTP codes are then only returned in
# the login response while NODE_ENV is not "production".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@markova.edu
SMTP_FROM_NAME=Markova School

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Leave TWILIO_SID empty to disable SMS delivery.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SENDER_ID=Markova

# ── Push notifications (Expo) ────────────────────────────────────────────────
# Only needed for the mobile app. An access token is required if the Expo
# project enforces push security; otherwise leave blank.
EXPO_ACCESS_TOKEN=

# ── PDF export ───────────────────────────────────────────────────────────────
# Path to a Chrome/Chromium binary for report-card PDF rendering.
# macOS:  /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:  /usr/bin/chromium
# Docker: set automatically in backend/Dockerfile
CHROME_PATH=

# ── Error tracking (optional) ────────────────────────────────────────────────
SENTRY_DSN=
