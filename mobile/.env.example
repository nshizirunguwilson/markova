# Markova mobile - local development environment
# Copy to .env. Expo reads EXPO_PUBLIC_* at build time and inlines them.

# Where the API lives. On a physical device this must be a host the phone can
# reach - your machine's LAN address, not localhost.
#   simulator/emulator: http://localhost:3000/api
#   physical device:    http://192.168.1.42:3000/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Socket.io origin for realtime messaging. Defaults to the API URL without /api.
EXPO_PUBLIC_WS_URL=http://localhost:3000

# EAS project id, printed by `eas init`. Required for push notifications in a
# standalone build; leave blank for Expo Go.
EAS_PROJECT_ID=
