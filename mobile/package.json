{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "open -a Simulator && expo start --ios",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "design:check": "tsx scripts/check-contrast.ts",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.94.5",
    "axios": "^1.13.6",
    "expo": "~55.0.29",
    "expo-camera": "~55.0.21",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-device": "~55.0.20",
    "expo-document-picker": "~55.0.15",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.23",
    "expo-linking": "~55.0.17",
    "expo-modules-core": "^55.0.25",
    "expo-notifications": "~55.0.26",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.19",
    "lucide-react-native": "^0.577.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "socket.io-client": "^4.8.3",
    "sonner-native": "^0.23.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.21",
    "react-test-renderer": "^19.1.0",
    "test-renderer": "^1.2.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|sonner-native|lucide-react-native|react-native-css-interop))"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!src/types/index.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/test/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "coverageThreshold": {
      "global": {
        "statements": 99,
        "branches": 97,
        "functions": 99,
        "lines": 99
      }
    }
  }
}
